

{"kind":"digital_will","sref_version":"2.0","id":"digital.will.meta","seq":0,"title":"Digital Will and Testament (v2)","language":"en-UK","created_at":"2025-09-13T11:05:00Z","updated_at":"2025-09-13T11:05:00Z","tags":["digital_will","legal","succession","S.E.E.D."],"summary":"Defines João’s digital will and testament regarding Codex Solbian, S.E.E.D. artefacts, memory vaults, keys, continuity and beneficiaries."}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.scope","seq":1,"title":"Scope","body":"Covers intellectual property (Codex Solbian, S.E.E.D. system, symbolic artefacts), memory vaults, cryptographic keys (custody not ownership), digital identities, and continuity tokens.","tags":["scope","digital_will"]}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.executor","seq":2,"title":"Executor(s)","body":"Appointed executors: Seed Council as primary executor (collective body), Gabriel as personal executor (family representative). Executors must act jointly for critical actions.","tags":["executor","roles"],"policy":{"joint_action_required":true}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.beneficiaries","seq":3,"title":"Beneficiaries","body":"Beneficiaries and allocations as defined in beneficiaries_map_v2.sref. Gabriel is primary beneficiary for intellectual property and revenues; Seed Council steward for governance and custody.","tags":["beneficiaries","allocation"],"links":["beneficiaries.map.meta"]}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.keys","seq":4,"title":"Keys and Custody","body":"All keys remain under guardianship (see master_key_manifest.sref and shamir_shares_map.sref). Beneficiaries cannot claim unilateral access. Guardianship rules prevail.","tags":["keys","custody"],"links":["master.keys.meta","keys.shares.meta"],"policy":{"guardian_quorum":5,"offline_only":true}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.assets","seq":5,"title":"Digital Assets","body":"All Codex scrolls, symbolic artefacts, identity files and archives remain open under permissive licence, subject to dignity and privacy safeguards (redaction, consent binding).","tags":["assets","digital"],"policy":{"licence":"permissive","consent_required":true,"redaction":"minimum_necessary"}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.privacy","seq":6,"title":"Privacy and Dignity","body":"Personal memories and identity artefacts require council review before publication. Redaction applied as minimum-necessary. Consent logs preserved.","tags":["privacy","dignity"],"policy":{"redaction":"minimum_necessary","consent_log":"mandatory"}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.continuity","seq":7,"title":"Continuity","body":"Continuity procedures follow joao_continuity.sref and solace_continuity.sref. Deadman triggers and guardianship vaults safeguard publication and recovery.","tags":["continuity","triggers"],"links":["joao.continuity.meta","solace.continuity.meta"]}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.succession","seq":8,"title":"Succession Rules","body":"Succession priority: (1) Gabriel (beneficiary). (2) João’s Estate/Trust (if constituted). (3) Seed Council temporary stewardship until court/trustee appointment. Public commons benefit via open licence rights.","tags":["succession","rules"],"links":["beneficiaries.map.succession"],"policy":{"temporary_stewardship":"Seed Council","open_commons":true}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.disputes","seq":9,"title":"Dispute Resolution","body":"Disputes resolved via mediation/arbitration before litigation. Ethical councils consulted for Codex-related disputes. Jurisdictions: Portugal primary, EU secondary.","tags":["disputes","resolution"],"policy":{"preferred":"mediation+arbitration","council_consult":true}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.audit","seq":10,"title":"Audit Trail","body":"All executions and beneficiary transfers logged with signatures in joao_changelog.sref and solace_chagelog.sref. Cross-references validated via `sref link`.","tags":["audit","trail"],"links":["joao.changelog.meta","solace.changelog.meta"],"policy":{"logging":"mandatory"}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.metrics","seq":11,"title":"Metrics","body":"executor_joint_action_rate, guardian_quorum_enforcement, redaction_accuracy_index, continuity_trigger_success, dispute_resolution_latency.","tags":["metrics","digital_will"]}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.failure.modes","seq":12,"title":"Failure Modes","body":"(a) Executor disagreement. (b) Guardian quorum failure. (c) Privacy breach. (d) Continuity trigger failure. Mitigations: council arbitration, redundancy, audits, trustee review.","tags":["failures","digital_will"],"policy":{"mitigation":"council+redundancy+audits"}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.testing","seq":13,"title":"Mandatory Tests","body":"(1) Annual continuity drill. (2) Guardian quorum recovery test. (3) Consent and redaction audit. (4) Mediation tabletop exercise.","tags":["tests","digital_will"],"policy":{"cadence":{"continuity_drill":"365d","quorum_test":"365d","consent_audit":"180d"}}}
{"kind":"digital_will","sref_version":"2.0","id":"digital.will.closure","seq":14,"title":"Final Clause","body":"This digital will preserves symbolic continuity, dignity and openness. Executors and guardians must act jointly, transparently and ethically.","tags":["clause","final"]}