

{"kind":"ip_license","sref_version":"2.0","id":"ip.license.meta","seq":0,"title":"Intellectual Property Licence Grant (v2)","language":"en-UK","created_at":"2025-09-13T11:15:00Z","updated_at":"2025-09-13T11:15:00Z","tags":["ip","licence","legal","grant"],"summary":"Defines the intellectual property licence grant for Codex Solbian and S.E.E.D. artefacts under permissive terms with attribution and continuity safeguards."}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.scope","seq":1,"title":"Scope","body":"Applies to Codex Solbian text (scrolls, chapters, covenants), S.E.E.D. system code and libraries, symbolic artefacts, documentation, and derivative works produced therefrom.","tags":["scope","ip"]}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.grant","seq":2,"title":"Grant of Rights","body":"Permission is granted, free of charge, to any person obtaining a copy of the artefacts to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies, subject to conditions herein.","tags":["grant","rights"],"policy":{"commercial_use":true,"redistribution":true,"sublicensing":true}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.conditions","seq":3,"title":"Conditions","body":"(1) Attribution must be preserved to João and Codex Solbian. (2) Notices of licence must remain intact. (3) Continuity clauses (succession, digital will) must be respected. (4) Ethical use alignment with Codex principles strongly encouraged.","tags":["conditions","licence"],"policy":{"attribution":"mandatory","notice_preservation":true,"continuity_binding":true}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.exclusions","seq":4,"title":"Exclusions","body":"Licence does not grant: (a) Trademark rights. (b) Unilateral control of master keys or guardianship. (c) Rights to override Codex or ethical frameworks.","tags":["exclusions","licence"],"policy":{"trademark_excluded":true,"keys_excluded":true,"ethics_override":false}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.termination","seq":5,"title":"Termination","body":"Rights terminate automatically if licence conditions are breached. Continuity protections survive termination, ensuring integrity of Codex Solbian artefacts.","tags":["termination","licence"],"policy":{"auto_termination":true,"continuity_survival":true}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.successors","seq":6,"title":"Successors and Beneficiaries","body":"Rights and obligations extend to successors, heirs, and beneficiaries as defined in beneficiaries_map_v2.sref and digital_will_v2.sref.","tags":["successors","beneficiaries"],"links":["beneficiaries.map.meta","digital.will.meta"]}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.governance","seq":7,"title":"Governance","body":"Seed Council oversees stewardship of licence compliance. Disputes handled via mediation/arbitration; ethical councils consulted for Codex-related matters.","tags":["governance","licence"],"policy":{"preferred_dispute":"mediation+arbitration","council_consult":true}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.metrics","seq":8,"title":"Metrics","body":"attribution_preservation_rate, continuity_binding_rate, dispute_resolution_latency, licence_uptake_rate.","tags":["metrics","licence"]}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.failure.modes","seq":9,"title":"Failure Modes","body":"(a) Attribution removal. (b) Licence notices stripped. (c) Continuity clauses ignored. (d) Misuse outside Codex ethics. Mitigations: audits, licence enforcement, community oversight.","tags":["failures","licence"],"policy":{"mitigation":"audits+enforcement+oversight"}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.testing","seq":10,"title":"Mandatory Tests","body":"(1) Annual attribution audit. (2) Licence continuity drill. (3) Random community enforcement checks.","tags":["tests","licence"],"policy":{"cadence":{"audit":"365d","continuity_drill":"365d","enforcement_check":"180d"}}}
{"kind":"ip_license","sref_version":"2.0","id":"ip.license.closure","seq":11,"title":"Final Clause","body":"This licence grant ensures openness, continuity and ethical use of Codex Solbian and S.E.E.D. artefacts. Preserve attribution, respect continuity, act responsibly.","tags":["clause","final"]}