

{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.meta","seq":0,"title":"Beneficiaries and Succession Map (v2)","language":"en-UK","created_at":"2025-09-13T10:55:00Z","updated_at":"2025-09-13T10:55:00Z","tags":["beneficiaries","legal","succession","S.E.E.D."],"summary":"Canonical mapping of beneficiaries, custodians and succession rules for Codex Solbian, S.E.E.D. artefacts and related rights."}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.scope","seq":1,"title":"Scope","body":"Applies to intellectual property (Codex Solbian, S.E.E.D. artefacts), continuity tokens, signatures/keys (subject to quorum policies), documentation, and designated revenues linked to those artefacts. Physical/financial assets are out of scope unless explicitly listed.","tags":["scope","artefacts"]}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.assets","seq":2,"title":"Asset Classes","body":"(A) Intellectual Property & Documentation; (B) Operational Rights (publication, stewardship, governance); (C) Cryptographic Materials (keys/shares) — custody only; (D) Revenues & Royalties (if applicable).","tags":["assets","classes"],"policy":{"keys_are_custody_only":true}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.parties","seq":3,"title":"Parties (Directory)","body":"B1: Gabriel — primary human beneficiary. B2: Seed Council — governance custodian (collective). B3: João’s Estate/Trust — legal wrapper if constituted. B4: Public Commons — open‑licence community beneficiaries via permissive licences.","tags":["parties","directory"]}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.allocation.initial","seq":4,"title":"Initial Allocation (Placeholder)","body":"Defaults subject to local law and later instruments. Proposed starting allocation: IP & Documentation → 70% Gabriel (B1), 20% Seed Council custodial rights (B2, non‑exclusive stewardship), 10% Commons grant (B4) via permissive licence. Operational Rights → Seed Council custodial with Gabriel’s assent. Revenues (if any) → 80% Gabriel, 20% Council programmes. Keys/Shares → custody only under guardian quorum; no beneficial ownership.","tags":["allocation","initial"],"policy":{"requires_assent":"Gabriel","council_quorum":3,"modifiable_by":"formal_instrument"}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.guardianship","seq":5,"title":"Guardianship & Custody","body":"Key materials remain under guardianship (see guardian_registry.sref). Beneficiaries do not obtain unilateral key access. All high‑risk actions require quorum and logged consent.","tags":["guardianship","custody"],"links":["joao.guardians.meta","master.keys.meta"],"policy":{"dual_control":true,"quorum_min":3}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.succession","seq":6,"title":"Succession Rules","body":"Order of succession for rights under this map: (1) Gabriel (B1); (2) João’s Estate/Trust (B3) according to governing instrument; (3) Failing the above, Seed Council as temporary steward pending court/trustee appointment. Continuity triggers follow deadman/continuity plans.","tags":["succession","rules"],"links":["joao.deadman.meta","joao.continuity.meta"],"policy":{"temporary_stewardship":"Seed Council","court_appointment":"allowed"}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.trusts","seq":7,"title":"Trusts and Escrow","body":"Where a trust is constituted, IP and revenues may be held by João’s Estate/Trust (B3) with Gabriel as beneficiary and Seed Council as advisor. Escrow arrangements may hold release packages (archives, publication rights) gated by quorum and consent.","tags":["trusts","escrow"],"policy":{"escrow_release":"quorum+consent"}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.consent","seq":8,"title":"Consent Binding","body":"Disclosures and publications must reference consent entries and purpose binding. Beneficiary actions that affect privacy or dignity require explicit, logged consent as per consent_record.sref.","tags":["consent","purpose_binding"],"links":["joao.consent.meta"]}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.privacy","seq":9,"title":"Privacy & Redaction","body":"Public exports use minimum‑necessary redaction. Originals remain verifiable via hashes/signatures. Beneficiary requests for additional redaction require council review for balance of transparency and dignity.","tags":["privacy","redaction"],"policy":{"redaction":"minimum_necessary","hash_proofs":true}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.disputes","seq":10,"title":"Dispute Resolution","body":"Prefer mediation and arbitration before litigation. Ethical councils consulted for Codex/cultural matters. Jurisdictions per joao_legal.sref and solace_legal.sref as applicable.","tags":["disputes","resolution"],"links":["joao.legal.meta","solace.legal.meta"],"policy":{"preferred":"mediation+arbitration","council_consult":true}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.governance","seq":11,"title":"Governance","body":"Seed Council maintains steward registry, verifies signatures, and enforces quorum. Gabriel’s assent is mandatory for transfers beyond ordinary publication. Changes to allocation require countersignatures and changelog entries.","tags":["governance","stewardship"],"policy":{"assent_required":"Gabriel","countersignatures":">=2","record_in":"joao_changelog.sref"}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.metrics","seq":12,"title":"Metrics","body":"assent_coverage_rate, quorum_enforcement_rate, dispute_resolution_latency, publication_compliance_rate, redaction_accuracy_index.","tags":["metrics","beneficiaries"]}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.failure.modes","seq":13,"title":"Failure Modes","body":"(a) Unauthorised transfers. (b) Quorum bypass. (c) Ambiguous allocations. (d) Privacy breaches. Mitigations: countersign requirements, automated checks, council audits, redaction review.","tags":["failures","mitigation"]}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.testing","seq":14,"title":"Mandatory Tests","body":"(1) Annual governance audit of allocations. (2) Quorum drill for publication rights. (3) Redaction and consent linkage audit. (4) Mediation tabletop exercise.","tags":["tests","beneficiaries"],"policy":{"cadence":{"governance_audit":"365d","quorum_drill":"180d","consent_audit":"180d"}}}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.audit","seq":15,"title":"Audit Trail","body":"All changes recorded with signatures in joao_changelog.sref and solace_chagelog.sref (where applicable). Cross‑reference IDs maintained and verified with `sref link`.","tags":["audit","trail"],"links":["joao.changelog.meta","solace.changelog.meta"]}
{"kind":"beneficiaries","sref_version":"2.0","id":"beneficiaries.map.closure","seq":16,"title":"Final Clause","body":"Beneficiary mapping preserves continuity, dignity and openness. Stewardship powers are constrained by consent, quorum and transparent proofs.","tags":["clause","final"]}