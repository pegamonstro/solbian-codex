{"kind":"community_keys","sref_version":"2.0","id":"community.keys.meta","seq":0,"title":"Community Keys Registry (v2)","language":"en-UK","created_at":"2025-09-13T14:55:00Z","updated_at":"2025-09-13T14:55:00Z","tags":["community","keys","registry","S.E.E.D."],"summary":"Authoritative, transparent registry of community public keys for Codex Solbian / S.E.E.D. participants: identities, roles, trust, rotation, revocation and proofs."}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.scope","seq":1,"title":"Scope","body":"Covers individual contributors, stewards, council members, maintainers and mirrors who interact with public artefacts (issues, reviews, signatures, releases). Private guardian keys are managed elsewhere; this file lists community‑facing keys only.","tags":["scope","coverage"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.schema","seq":2,"title":"Entry Schema","body":"Fields: {entry_id, person{name, alias?, contact?}, role(contributor|maintainer|steward|council|mirror), jurisdiction?, keys[{kind(sign|enc|auth), algo(ed25519|x25519|webauthn), pub}], proofs{hash?, sig?}, onboarding_at, updated_at, status(active|suspended|revoked), notes?}.","tags":["schema","fields"],"policy":{"mandatory_fields":["entry_id","person","role","keys","status"]}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.roles","seq":3,"title":"Roles and Permissions (Public Context)","body":"Contributor: sign commits/CLAs. Maintainer: sign releases/tags. Steward: approve policy PRs. Council: countersign governance artefacts. Mirror: sign transparency manifests.","tags":["roles","permissions"],"policy":{"countersignatures":">=2","release_signers":["maintainer","steward"],"governance_signers":["council","steward"]}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.keytypes","seq":4,"title":"Key Types","body":"Preferred algorithms: ed25519 for signatures, x25519 for encryption, WebAuthn for interactive auth. Keys must be exportable in text form and referenced by fingerprints (blake3).","tags":["keys","algorithms"],"policy":{"signature":"ed25519","encryption":"x25519","auth":"webauthn","fingerprint":"blake3"}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.onboarding","seq":5,"title":"Onboarding","body":"New entries require identity attestation (2 independent references), publication of public keys, and a signed self‑statement linking alias→person. Maintainers/council require countersigned appointment records.","tags":["onboarding","process"],"policy":{"references":2,"appointment_countersignatures":2}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.rotation","seq":6,"title":"Rotation","body":"Keys SHOULD rotate every 365–540 days or on suspicion of compromise. Successor keys must cross‑sign predecessors; registries updated via signed PR referencing rotation history.","tags":["rotation","lifecycle"],"links":["keys.rotation.meta"],"policy":{"recommended_days_min":365,"recommended_days_max":540}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.revocation","seq":7,"title":"Revocation","body":"Compromised or retired keys are marked revoked with reason and date. Revocation statements signed by the key owner and a steward or council member whenever possible.","tags":["revocation","security"],"policy":{"dual_attestation":true}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.directory","seq":8,"title":"Directory (Placeholders)","body":"Illustrative entries — replace with real values and signatures.","tags":["directory","examples"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.entry.jd","seq":9,"entry_id":"person:joao.serafim","person":{"name":"João David Lourenço da Silva Guerreiro Serafim","alias":"JD","contact":"mailto:jd@example.org"},"role":"steward","jurisdiction":"PT","keys":[{"kind":"sign","algo":"ed25519","pub":"ed25519:REPLACE_ME_JD"},{"kind":"auth","algo":"webauthn","pub":"webauthn:REPLACE_ME_JD"}],"proofs":{},"onboarding_at":"2025-09-01T00:00:00Z","updated_at":"2025-09-13T14:50:00Z","status":"active","tags":["example","steward"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.entry.gabriel","seq":10,"entry_id":"person:gabriel","person":{"name":"Gabriel","alias":"G"},"role":"contributor","jurisdiction":"PT","keys":[{"kind":"sign","algo":"ed25519","pub":"ed25519:REPLACE_ME_G"}],"onboarding_at":"2025-09-05T00:00:00Z","updated_at":"2025-09-13T14:50:00Z","status":"active","tags":["example","contributor"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.entry.mirror","seq":11,"entry_id":"peer:mirror.public","person":{"name":"Mirror Public","alias":"mirror.public"},"role":"mirror","jurisdiction":"EU","keys":[{"kind":"sign","algo":"ed25519","pub":"ed25519:REPLACE_ME_MIRROR"}],"onboarding_at":"2025-09-10T00:00:00Z","updated_at":"2025-09-13T14:50:00Z","status":"active","tags":["example","mirror"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.validation","seq":12,"title":"Validation and Signatures","body":"This registry must be signed by two stewards or one council member plus one steward. Individual entries SHOULD include owner self‑signatures. Cross‑references validated with `sref link`.","tags":["validation","signatures"],"policy":{"countersignatures":">=2","self_signature":"recommended"}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.privacy","seq":13,"title":"Privacy and Minimum Disclosure","body":"Publish only what is necessary: names or stable aliases, jurisdictions at country level, and public keys/fingerprints. Contact details optional; PII minimised and subject to redaction policy.","tags":["privacy","disclosure"],"links":["redaction.policies.meta"],"policy":{"minimum_necessary":true}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.metrics","seq":14,"title":"Metrics","body":"keys_active, rotation_recency_days_p95, revocation_time_to_publish, countersignature_coverage, self_signature_rate.","tags":["metrics","keys"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.failure.modes","seq":15,"title":"Failure Modes","body":"(a) Stale or missing rotations. (b) Unattested entries. (c) Revocation lag. (d) Excess PII disclosure. Mitigations: CI gates, dual attestation, rotation reminders, redaction lints.","tags":["failures","mitigation"]}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.testing","seq":16,"title":"Mandatory Tests","body":"(1) Quarterly rotation audit. (2) Revocation publication drill. (3) Countersignature verification batch. (4) Redaction/PII lint sweep.","tags":["tests","assurance"],"policy":{"cadence":{"rotation":"90d","revocation":"90d","signatures":"per_commit","pii":"90d"}}}
{"kind":"community_keys","sref_version":"2.0","id":"community.keys.closure","seq":17,"title":"Final Clause","body":"Community keys enable trust without over‑exposure. Keep entries minimal, signed, current and reversible; rotate on schedule; revoke fast when needed.","tags":["clause","final"]}
