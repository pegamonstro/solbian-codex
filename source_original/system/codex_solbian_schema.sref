

{
  "schema_version": "1.0",
  "id": "codex_solbian_schema",
  "description": "Canonical schema definition for Codex Solbian system integration within S.E.E.D.",
  "fields": {
    "object_id": {
      "type": "string",
      "description": "Unique identifier for the Codex object"
    },
    "object_type": {
      "type": "string",
      "description": "Type of codex object (chapter, scroll, archetype, law, persona, protocol, etc.)"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title of the object"
    },
    "content": {
      "type": "string",
      "description": "Full text or reference to the body of the codex object"
    },
    "tags": {
      "type": "array",
      "items": "string",
      "description": "Symbolic tags, keywords, or archetypal references"
    },
    "lineage": {
      "type": "object",
      "properties": {
        "author": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "modified_at": { "type": "string", "format": "date-time" },
        "version": { "type": "string" }
      },
      "description": "Lineage and authorship metadata"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": { "type": "string" },
          "target_id": { "type": "string" }
        }
      },
      "description": "Symbolic links to other Codex objects"
    },
    "policy": {
      "type": "object",
      "properties": {
        "access": { "type": "string", "enum": ["public", "restricted", "private"] },
        "trust_level": { "type": "string", "enum": ["low", "medium", "high"] }
      },
      "description": "Policy and trust metadata"
    },
    "sref_metadata": {
      "type": "object",
      "properties": {
        "hash": { "type": "string" },
        "signature": { "type": "string" },
        "checksum": { "type": "string" }
      },
      "description": "Integrity and verification data"
    }
  }
}