{
  "sref_version": "v5",
  "schema_id": "seed.schema.api.examples",
  "schema_version": "1.0.0",
  "type": "api_examples",
  "id": "icaan.api.examples",
  "timestamp": "2025-09-19T12:30:00Z",
  "meta": {
    "created_at": "2025-09-19T12:30:00Z",
    "authors": ["seed-system"],
    "license": "CC-BY-SA-4.0",
    "status": "active",
    "notes": [
      "Extended usage examples for ICAAN API library.",
      "Covers domain lookup, registration, WHOIS, RDAP, DNSSEC, pagination, rate limiting, retries, webhooks, and security.",
      "Designed for ingestion into S.E.E.D. (seedmem) and policy‑guarded by Codex Solbian."
    ],
    "depends_on": [
      "codex/system/icaan_api_library.sref",
      "codex_solbian/system/codex_solbian_glyph_library.sref",
      "codex_solbian/system/codex_solbian_identifiers.sref",
      "codex_solbian/system/codex_solbian_policy_map.sref",
      "codex_solbian/system/codex_solbian_schema.sref"
    ]
  },
  "context": {
    "base_url": "https://api.icaan.example",
    "auth": {
      "flow": "client_credentials",
      "token_url": "/v1/oauth/token",
      "scopes": ["read:domains", "write:domains", "read:whois", "read:rdap", "read:dnssec"]
    },
    "conventions": {
      "date_time": "RFC3339",
      "errors": {
        "schema": "{code, http, message, details?}",
        "retryable_codes": [429, 500, 502, 503, 504]
      },
      "rate_limit_headers": ["X-RateLimit-Limit", "X-RateLimit-Remaining", "X-RateLimit-Reset"],
      "pagination": {
        "style": "cursor",
        "params": ["limit", "cursor"],
        "response_keys": ["items", "next_cursor"]
      }
    },
    "seed_guardrails": {
      "policy_map": "codex_solbian/system/codex_solbian_policy_map.sref",
      "schema": "codex_solbian/system/codex_solbian_schema.sref",
      "glyphs": "codex_solbian/system/codex_solbian_glyph_library.sref",
      "identifiers": "codex_solbian/system/codex_solbian_identifiers.sref"
    }
  },
  "examples": [
    {
      "id": "ex.domain.lookup.available",
      "title": "Domain availability lookup (available)",
      "endpoint": "domain.lookup",
      "request": {
        "method": "GET",
        "url": "/v1/domain/lookup",
        "query": {"domain": "seedmesh.dev"},
        "headers": {"Authorization": "Bearer <token>"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "domain": "seedmesh.dev",
          "status": "available",
          "registrar": null,
          "created_at": null,
          "expires_at": null
        }
      },
      "cli": {
        "curl": "curl -s -H 'Authorization: Bearer $TOKEN' 'https://api.icaan.example/v1/domain/lookup?domain=seedmesh.dev'",
        "seedctl": "seedctl net rpc icaan domain.lookup '{\"domain\":\"seedmesh.dev\"}'"
      },
      "notes": ["Use before attempting registration."]
    },
    {
      "id": "ex.domain.lookup.registered",
      "title": "Domain availability lookup (registered)",
      "endpoint": "domain.lookup",
      "request": {
        "method": "GET",
        "url": "/v1/domain/lookup",
        "query": {"domain": "example.org"},
        "headers": {"Authorization": "Bearer <token>"}
      },
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "domain": "example.org",
          "status": "registered",
          "registrar": "NameRegistrar",
          "created_at": "2001-03-12T00:00:00Z",
          "expires_at": "2031-03-12T00:00:00Z"
        }
      },
      "cli": {
        "curl": "curl -s -H 'Authorization: Bearer $TOKEN' 'https://api.icaan.example/v1/domain/lookup?domain=example.org'",
        "seedctl": "seedctl net rpc icaan domain.lookup '{\"domain\":\"example.org\"}'"
      },
      "notes": ["Expect status=registered; WHOIS/RDAP provide authoritative details."]
    },
    {
      "id": "ex.domain.register.success",
      "title": "Register a domain (success)",
      "endpoint": "domain.register",
      "request": {
        "method": "POST",
        "url": "/v1/domain/register",
        "headers": {"Authorization": "Bearer <token>", "Content-Type": "application/json"},
        "body": {
          "domain": "seedmesh.dev",
          "registrant": {"name": "JD", "email": "jd@example.com", "address": "Rua Sol, 100, Lisboa"},
          "period": 1
        }
      },
      "response": {
        "status": 201,
        "headers": {"Content-Type": "application/json", "X-Order-Id": "ORD-12345"},
        "body": {"domain": "seedmesh.dev", "status": "pending_create", "order_id": "ORD-12345"}
      },
      "webhooks": [
        {
          "event": "domain.create.completed",
          "payload": {"domain": "seedmesh.dev", "status": "active", "order_id": "ORD-12345", "activated_at": "2025-09-19T12:31:10Z"}
        }
      ],
      "cli": {
        "curl": "curl -s -X POST -H 'Authorization: Bearer $TOKEN' -H 'Content-Type: application/json' \n          -d '{\"domain\":\"seedmesh.dev\",\"registrant\":{\"name\":\"JD\",\"email\":\"jd@example.com\",\"address\":\"Rua Sol, 100, Lisboa\"},\"period\":1}' \n          https://api.icaan.example/v1/domain/register"
      }
    },
    {
      "id": "ex.domain.register.conflict",
      "title": "Register a domain (conflict)",
      "endpoint": "domain.register",
      "request": {
        "method": "POST",
        "url": "/v1/domain/register",
        "headers": {"Authorization": "Bearer <token>", "Content-Type": "application/json"},
        "body": {"domain": "example.org", "registrant": {"name": "JD", "email": "jd@example.com"}}
      },
      "response": {
        "status": 409,
        "body": {"code": "DOMAIN_ALREADY_REGISTERED", "message": "The domain is already registered."}
      },
      "retry": {"strategy": "none", "notes": "Conflict is terminal; choose a different domain."}
    },
    {
      "id": "ex.whois.query",
      "title": "WHOIS query",
      "endpoint": "whois.query",
      "request": {
        "method": "GET",
        "url": "/v1/whois/example.org",
        "headers": {"Authorization": "Bearer <token>"}
      },
      "response": {
        "status": 200,
        "body": {
          "domain": "example.org",
          "registrar": "Example Registrar LLC",
          "registrant": {"name": "Example Org", "country": "US"},
          "contacts": {"admin": "admin@example.org", "tech": "tech@example.org"},
          "dnssec": {"signed": true, "alg": "RSASHA256"},
          "status": ["clientTransferProhibited"]
        }
      }
    },
    {
      "id": "ex.rdap.query",
      "title": "RDAP query",
      "endpoint": "rdap.query",
      "request": {
        "method": "GET",
        "url": "/v1/rdap/example.org",
        "headers": {"Authorization": "Bearer <token>"}
      },
      "response": {
        "status": 200,
        "body": {
          "handle": "EXAMPLE-ORG",
          "entities": [{"role": "registrant", "vcard": {"fn": "Example Org"}}],
          "events": [{"action": "registration", "date": "2001-03-12T00:00:00Z"}],
          "status": ["active"],
          "nameservers": ["ns1.example.org", "ns2.example.org"]
        }
      }
    },
    {
      "id": "ex.dnssec.status.signed",
      "title": "DNSSEC status (signed)",
      "endpoint": "dnssec.status",
      "request": {"method": "GET", "url": "/v1/dnssec/example.org", "headers": {"Authorization": "Bearer <token>"}},
      "response": {"status": 200, "body": {"domain": "example.org", "dnssec_status": "signed", "ds_records": ["12345 8 2 ABC...", "54321 8 2 DEF..."]}}
    },
    {
      "id": "ex.dnssec.status.notsigned",
      "title": "DNSSEC status (not signed)",
      "endpoint": "dnssec.status",
      "request": {"method": "GET", "url": "/v1/dnssec/nosign.dev", "headers": {"Authorization": "Bearer <token>"}},
      "response": {"status": 200, "body": {"domain": "nosign.dev", "dnssec_status": "unsigned", "ds_records": []}},
      "notes": ["Advise enabling DNSSEC for integrity and trust."]
    },
    {
      "id": "ex.pagination.domains",
      "title": "List domains with cursor pagination",
      "endpoint": "domain.list",
      "request": {"method": "GET", "url": "/v1/domain/list?limit=2", "headers": {"Authorization": "Bearer <token>"}},
      "response": {
        "status": 200,
        "body": {
          "items": [
            {"domain": "a.dev", "status": "active"},
            {"domain": "b.dev", "status": "active"}
          ],
          "next_cursor": "eyJvZmZzZXQiOjJ9"
        },
        "headers": {"X-RateLimit-Remaining": "4999"}
      },
      "follow_up": {
        "request": {"method": "GET", "url": "/v1/domain/list?limit=2&cursor=eyJvZmZzZXQiOjJ9", "headers": {"Authorization": "Bearer <token>"}},
        "response": {"status": 200, "body": {"items": [{"domain": "c.dev", "status": "active"}], "next_cursor": null}}
      }
    },
    {
      "id": "ex.ratelimit.backoff",
      "title": "Handle rate limiting (429)",
      "endpoint": "whois.query",
      "request": {"method": "GET", "url": "/v1/whois/example.org", "headers": {"Authorization": "Bearer <token>"}},
      "response": {"status": 429, "body": {"code": "RATE_LIMIT", "message": "Too Many Requests"}, "headers": {"Retry-After": "2"}},
      "retry": {"strategy": "exponential", "base_ms": 200, "max_retries": 5}
    },
    {
      "id": "ex.security.oauth.token",
      "title": "Obtain OAuth token",
      "endpoint": "oauth.token",
      "request": {
        "method": "POST",
        "url": "/v1/oauth/token",
        "headers": {"Content-Type": "application/x-www-form-urlencoded"},
        "body": "grant_type=client_credentials&client_id=<id>&client_secret=<secret>&scope=read:domains read:whois"
      },
      "response": {
        "status": 200,
        "body": {"access_token": "eyJhbGciOi...", "token_type": "Bearer", "expires_in": 3600, "scope": "read:domains read:whois"}
      }
    },
    {
      "id": "ex.errors.validation",
      "title": "Invalid request (400)",
      "endpoint": "domain.register",
      "request": {"method": "POST", "url": "/v1/domain/register", "headers": {"Authorization": "Bearer <token>"}, "body": {"domain": "BAD SPACE"}},
      "response": {"status": 400, "body": {"code": "INVALID_REQUEST", "message": "Request parameters are invalid.", "details": [{"field": "domain", "issue": "invalid-format"}]}}
    },
    {
      "id": "ex.seedmem.ingest.reflection",
      "title": "Ingest WHOIS result into SeedMem and reflect",
      "endpoint": "whois.query",
      "request": {"method": "GET", "url": "/v1/whois/example.org", "headers": {"Authorization": "Bearer <token>"}},
      "response": {"status": 200, "body": {"domain": "example.org", "registrar": "Example Registrar LLC", "status": ["active"]}},
      "seed": {
        "ingest": "seedctl mem ingest codex/system/icaan_api_examples.sref",
        "reflect": "seedctl mem reflect --ids mem/vault/.../WHOIS_example_org.sref --engine reason --policy codex --local-only",
        "id_assign": "seedctl mem id --paths mem/vault/.../WHOIS_example_org.sref --embed 128 --local-only"
      }
    },
    {
      "id": "ex.webhook.domain.events",
      "title": "Webhook: domain lifecycle events",
      "endpoint": "webhook.domain",
      "request": {
        "method": "POST",
        "url": "https://seed.example/hooks/icaan",
        "headers": {"Content-Type": "application/json"},
        "body": {"event": "domain.transfer.started", "domain": "seedmesh.dev", "at": "2025-09-19T12:35:00Z", "id": "EVT-1001"}
      },
      "response": {"status": 200, "body": {"ok": true}},
      "security": {"signature": "X-ICAAN-Signature: sha256=abcd...", "verification": "HMAC over body with shared secret"}
    },
    {
      "id": "ex.bulk.lookup",
      "title": "Bulk domain lookup (batch)",
      "endpoint": "domain.lookup",
      "request": {"method": "POST", "url": "/v1/domain/lookup:batch", "headers": {"Authorization": "Bearer <token>", "Content-Type": "application/json"}, "body": {"domains": ["a.dev", "b.dev", "c.dev"]}},
      "response": {"status": 200, "body": {"results": [{"domain": "a.dev", "status": "available"}, {"domain": "b.dev", "status": "registered"}, {"domain": "c.dev", "status": "available"}]}}
    },
    {
      "id": "ex.retry.transient",
      "title": "Transient server error with retry",
      "endpoint": "whois.query",
      "request": {"method": "GET", "url": "/v1/whois/example.org", "headers": {"Authorization": "Bearer <token>"}},
      "response": {"status": 503, "body": {"code": "SERVICE_UNAVAILABLE", "message": "Try again later"}},
      "retry": {"strategy": "exponential", "base_ms": 300, "jitter": true, "max_retries": 4}
    },
    {
      "id": "ex.security.scopes",
      "title": "Scope‑restricted access",
      "endpoint": "rdap.query",
      "request": {"method": "GET", "url": "/v1/rdap/example.org", "headers": {"Authorization": "Bearer <token with only read:domains>"}},
      "response": {"status": 403, "body": {"code": "FORBIDDEN", "message": "Missing scope: read:rdap"}}
    },
    {
      "id": "ex.dnssec.ds.upload",
      "title": "Upload DS records (registrar API)",
      "endpoint": "dnssec.upload",
      "request": {"method": "POST", "url": "/v1/dnssec/example.org/ds", "headers": {"Authorization": "Bearer <token>", "Content-Type": "application/json"}, "body": {"ds_records": ["12345 8 2 ABC..."]}},
      "response": {"status": 202, "body": {"accepted": true, "job_id": "JOB-DS-777"}},
      "follow_up": {"request": {"method": "GET", "url": "/v1/jobs/JOB-DS-777"}, "response": {"status": 200, "body": {"state": "completed"}}}
    },
    {
      "id": "ex.monitor.health",
      "title": "Health check",
      "endpoint": "health",
      "request": {"method": "GET", "url": "/v1/health"},
      "response": {"status": 200, "body": {"ok": true, "version": "2025.09"}}
    },
    {
      "id": "ex.seednet.rpc.bridge",
      "title": "Call over SeedNet RPC bridge",
      "endpoint": "domain.lookup",
      "request": {"method": "RPC", "url": "seednet://icaan/domain.lookup", "body": {"domain": "mesh.dev"}},
      "response": {"status": 200, "body": {"domain": "mesh.dev", "status": "available"}},
      "notes": ["Demonstrates invoking ICAAN API via seednetd RPC service."]
    }
  ],
  "guides": [
    {
      "id": "guide.cli.quickstart",
      "title": "CLI quickstart with curl and seedctl",
      "steps": [
        "export TOKEN=$(curl -s -X POST -d 'grant_type=client_credentials&client_id=$ID&client_secret=$SECRET' https://api.icaan.example/v1/oauth/token | jq -r .access_token)",
        "curl -s -H 'Authorization: Bearer $TOKEN' 'https://api.icaan.example/v1/domain/lookup?domain=seedmesh.dev' | jq .",
        "seedctl net rpc icaan domain.lookup '{\"domain\":\"seedmesh.dev\"}' --json"
      ]
    },
    {
      "id": "guide.errors.retries",
      "title": "Handling rate limits and transient errors",
      "content": [
        "1) Inspect HTTP status and Retry-After header for 429.",
        "2) Use exponential backoff with jitter for 5xx.",
        "3) Cap max retries to protect budgets.",
        "4) Log correlation IDs (e.g., X-Request-Id)."
      ]
    },
    {
      "id": "guide.security",
      "title": "Security & scopes",
      "content": [
        "- Keep tokens in memory only; avoid committing to disk.",
        "- Minimal scopes for each call (principle of least privilege).",
        "- Rotate client secrets; monitor token use.",
        "- Validate webhook signatures (HMAC over raw body)."
      ]
    },
    {
      "id": "guide.seed.integration",
      "title": "Integrating with S.E.E.D. (seedmem/seedreason)",
      "content": [
        "- Ingest responses as immutable SREFs under mem/vault/codex/icaan/.",
        "- Run identifier assignment (tags, glyphs) using seedctl mem id.",
        "- Reflect with seedctl mem reflect to derive goals (e.g., renewals).",
        "- Enforce Codex Solbian guardrails on all writes."
      ]
    }
  ],
  "lineage": {
    "author": "Codex Solbian Maintainers",
    "created_at": "2025-09-19T12:30:00Z",
    "modified_at": "2025-09-19T12:30:00Z",
    "version": "0.9.0-pre"
  },
