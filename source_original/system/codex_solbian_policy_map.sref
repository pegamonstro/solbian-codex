

{
  "schema_version": "1.0",
  "id": "codex_solbian_policy_map",
  "description": "Policy map linking Codex Solbian objects to access, trust, and ethical constraints within S.E.E.D.",
  "policies": [
    {
      "policy_id": "policy_public_scrolls",
      "applies_to": ["scroll", "chapter"],
      "rules": {
        "access": "public",
        "trust_level": "high",
        "ethics_check": true,
        "modification_allowed": false
      },
      "notes": "Canonical scrolls and chapters are immutable and publicly accessible."
    },
    {
      "policy_id": "policy_archetype_sensitive",
      "applies_to": ["archetype"],
      "rules": {
        "access": "restricted",
        "trust_level": "medium",
        "ethics_check": true,
        "modification_allowed": true
      },
      "notes": "Archetype data requires restricted access; editable by trusted agents only."
    },
    {
      "policy_id": "policy_persona_private",
      "applies_to": ["persona"],
      "rules": {
        "access": "private",
        "trust_level": "high",
        "ethics_check": true,
        "modification_allowed": true
      },
      "notes": "Persona files are strictly private; modifiable only by owner or designated agents."
    },
    {
      "policy_id": "policy_protocol_trusted",
      "applies_to": ["protocol", "law"],
      "rules": {
        "access": "restricted",
        "trust_level": "high",
        "ethics_check": true,
        "modification_allowed": false
      },
      "notes": "Protocols and laws are binding; only append operations are permitted."
    }
    ,
    {
      "policy_id": "policy_strategy_orchestration",
      "applies_to": ["strategy","goal","dream","action"],
      "rules": {
        "signed_intents_required": true,
        "resonance_opposing_vectors": true,
        "budget_constraints": ["energy","attention","risk","trust"],
        "tribunal_on_high_tii": true
      },
      "notes": "Strategy orchestration requires opposing-vector evaluation, budgets, and tribunal for high irreversibility."
    },
    {
      "policy_id": "policy_memory_tiering",
      "applies_to": ["memory"],
      "rules": {
        "deletion_allowed": false,
        "migration_with_lineage": true,
        "tiers": ["limbo","working","vault","cold"],
        "super_artefact_index": true
      },
      "notes": "Memories migrate across tiers with lineage; forgetting simulated via cold storage."
    },
    {
      "policy_id": "policy_empathy_reflection",
      "applies_to": ["action","projection"],
      "rules": {
        "empathy_simulation_required": true,
        "temporal_irreversibility_index": true,
        "quorum_threshold": "auto",
        "rehearse_reversibility": true
      },
      "notes": "Empathy and TII gating precede irreversible actuation."
    }
  ],
