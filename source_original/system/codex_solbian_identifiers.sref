{
  "schema_version": "1.0",
  "id": "codex_solbian_identifiers",
  "description": "Canonical registry of identifier namespaces, formats, generation, and validation rules used across S.E.E.D.",
  "namespaces": [
    {
      "ns": "mem.object",
      "purpose": "Immutable memory object identifiers",
      "format": "sha256(hex)",
      "regex": "^[a-f0-9]{64}$",
      "generation": "SHA256(namespace||node_id||nonce||timestamp||content_merkle_root)",
      "example": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
      "collision_policy": "treat as distinct objects if merkle roots differ; no overwrite",
      "validation": ["hex64", "exists_in_vault", "merkle_root_matches"]
    },
    {
      "ns": "mem.chunk",
      "purpose": "Content-addressed chunk ID",
      "format": "sha256(hex)",
      "regex": "^[a-f0-9]{64}$",
      "generation": "SHA256(chunk_bytes)",
      "example": "1dcca23355272056f04fe8bf20edfce0...",
      "collision_policy": "deduplicate by exact hash",
      "validation": ["hex64", "blob_present"]
    },
    {
      "ns": "lease",
      "purpose": "Cooperative lock for mutable targets",
      "format": "base64url(hmac(seed_key, target||holder||issued_at||ttl_ms||lamport))",
      "regex": "^[A-Za-z0-9_-]{43,}$",
      "example": "Rj0D1m2Zc7n2E5wWm6l3bOe9YkqH0…",
      "collision_policy": "highest lamport and unexpired TTL wins",
      "validation": ["base64url", "hmac_verify", "ttl_valid", "lamport_monotonic"]
    },
    {
      "ns": "task",
      "purpose": "Distributed task ID",
      "format": "sha256(hex)",
      "regex": "^[a-f0-9]{64}$",
      "generation": "SHA256('task'||node_id||nonce||timestamp||dedup_key)",
      "example": "8f14e45fceea167a5a36dedd4bea2543…",
      "collision_policy": "if dedup_key matches active → reject or merge",
      "validation": ["hex64", "queue_presence"]
    },
    {
      "ns": "peer",
      "purpose": "SeedNet peer identity",
      "format": "base32(node pubkey hash, no padding)",
      "regex": "^[A-Z2-7]{16,}$",
      "generation": "BASE32_NOPAD(SHA256(peer_public_key))",
      "example": "MFRGGZDFMZTWQ2LK",
      "collision_policy": "unique per key; rotate on key change",
      "validation": ["base32", "pubkey_bound"]
    },
    {
      "ns": "session",
      "purpose": "SeedNet session ID",
      "format": "base64url(random 128-bit)",
      "regex": "^[A-Za-z0-9_-]{22}$",
      "generation": "base64url(rand128())",
      "example": "f3Q1Zb6m2eYpS6w2o7lF8A",
      "collision_policy": "reject on reuse; force rekey",
      "validation": ["base64url", "not_in_active_sessions"]
    },
    {
      "ns": "manifest",
      "purpose": "SeedFS manifest ID",
      "format": "sha256(hex) of manifest JSON canonical form",
      "regex": "^[a-f0-9]{64}$",
      "generation": "SHA256(CANONICAL_JSON(manifest))",
      "example": "4bf5122f344554c53bde2ebb8cd2b7e3…",
      "collision_policy": "immutable; new version → new ID",
      "validation": ["hex64", "canonical_json_hash_match"]
    },
    {
      "ns": "bus.topic",
      "purpose": "SeedBus topic canonical name",
      "format": "dot.separated",
      "regex": "^[a-z][a-z0-9]*(\\.[a-z0-9*_-]+)*$",
      "generation": "by convention",
      "example": "seedfs.write", 
      "collision_policy": "namespace by subsystem prefix",
      "validation": ["topic_prefix_allowed"]
    }
  ],
  "parsing_order": [
    "lease",
    "task",
    "session",
    "peer",
    "manifest",
    "mem.object",
    "mem.chunk",
    "bus.topic"
  ],
  "reserved_prefixes": ["seed.", "codex.", "sys.", "mem.", "pool.", "bus.", "policy.", "cfg.", "keys.", "peers."],
  "lineage": {
    "author": "Codex Solbian",
    "created_at": "2025-09-15T00:00:00Z",
    "modified_at": "2025-09-15T00:00:00Z",
    "version": "0.9.0-pre"
  },
  "sref_metadata": { "hash": "", "signature": "", "checksum": "" }
}