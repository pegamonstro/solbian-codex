{
  "schema_version": "1.0",
  "id": "codex_solbian_glyph_library",
  "description": "Canonical registry of glyphs, symbols, tags, and visual identifiers used across Codex Solbian and S.E.E.D.",
  "categories": [
    "core",
    "memory",
    "policy",
    "network",
    "filesystem",
    "pool",
    "status",
    "agent",
    "arithmos"
  ],
  "entries": [
    {
      "gid": "glyph.seed.mark",
      "name": "Seed Mark",
      "category": "core",
      "unicode": "U+2295",
      "ascii_fallback": "(*)",
      "svg_ref": "attachments/svg/glyph_seed_mark.svg",
      "semantics": {
        "summary": "Root emblem of S.E.E.D.; denotes canonical origin or root object.",
        "tags": ["seed", "origin", "root", "canonical"]
      },
      "usage": {
        "contexts": ["headers", "watermark", "signatures"],
        "sref_fields": ["lineage", "trust_envelope.required_trust"],
        "memory_roles": ["root-of-trust", "index-anchor"]
      },
      "policy": { "access": "public", "trust_level": "high" }
    },
    {
      "gid": "glyph.mem.object",
      "name": "Memory Object",
      "category": "memory",
      "unicode": "U+25A3",
      "ascii_fallback": "[#]",
      "svg_ref": "attachments/svg/glyph_memory_object.svg",
      "semantics": {
        "summary": "Represents an immutable memory object (.sref + blobs).",
        "tags": ["memory", "immutable", "vault"]
      },
      "usage": {
        "contexts": ["ui", "graphs", "logs"],
        "sref_fields": ["integrity.merkle_root", "seed_integration.mem_vault_paths.vault"],
        "memory_roles": ["vault-object"]
      },
      "policy": { "access": "public", "trust_level": "high" }
    },
    {
      "gid": "glyph.mem.lease",
      "name": "Lease Lock",
      "category": "filesystem",
      "unicode": "U+1F512",
      "ascii_fallback": "{L}",
      "svg_ref": "attachments/svg/glyph_lease_lock.svg",
      "semantics": {
        "summary": "Indicates an active lease controlling mutation of a target.",
        "tags": ["lease", "lock", "ttl", "exclusive"]
      },
      "usage": {
        "contexts": ["ui", "pool/queue", "context/"],
        "sref_fields": ["lease.holder", "lease.ttl_ms", "lease.heartbeat_seq"],
        "memory_roles": ["mutable-guard"]
      },
      "policy": { "access": "public", "trust_level": "high" }
    },
    {
      "gid": "glyph.net.peer",
      "name": "Peer Node",
      "category": "network",
      "unicode": "U+25CF",
      "ascii_fallback": "(o)",
      "svg_ref": "attachments/svg/glyph_peer_node.svg",
      "semantics": {
        "summary": "Represents a SeedNet peer in the mesh.",
        "tags": ["peer", "mesh", "seednet"]
      },
      "usage": {
        "contexts": ["topology", "health", "scores"],
        "sref_fields": ["peers.node_id", "peers.score", "peers.updated_at"],
        "memory_roles": ["peer-manifest"]
      },
      "policy": { "access": "public", "trust_level": "high" }
    },
    {
      "gid": "glyph.pool.task",
      "name": "Task",
      "category": "pool",
      "unicode": "U+25B6",
      "ascii_fallback": ">",
      "svg_ref": "attachments/svg/glyph_task.svg",
      "semantics": {
        "summary": "Represents a scheduled or running task.",
        "tags": ["task", "queue", "runner"]
      },
      "usage": {
        "contexts": ["pool/queue", "dashboards", "logs"],
        "sref_fields": ["task.state", "task.priority", "task.owner"],
        "memory_roles": ["work-item"]
      },
      "policy": { "access": "public", "trust_level": "high" }
    },
    {
      "gid": "glyph.sync.delta",
      "name": "Sync Delta",
      "category": "network",
      "unicode": "U+21C4",
      "ascii_fallback": "<>",
      "svg_ref": "attachments/svg/glyph_sync_delta.svg",
      "semantics": {
        "summary": "Indicates a replication delta or manifest exchange.",
        "tags": ["sync", "delta", "replication"]
      },
      "usage": {
        "contexts": ["seednet.sync", "seedfs.replicate"],
        "sref_fields": ["manifest.merkle_root", "manifest.chunks"],
        "memory_roles": ["replication-unit"]
      },
      "policy": { "access": "public", "trust_level": "high" }
    }
  ],
  "lineage": {
    "author": "Codex Solbian",
    "created_at": "2025-09-15T00:00:00Z",
