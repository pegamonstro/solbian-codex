

{
  "sref_version": "5.0",
  "type": "codex_solbian_agent_hooks",
  "description": "Defines agent lifecycle hooks and integration points for Codex Solbian agents within the S.E.E.D. system.",
  "hooks": {
    "on_spawn": {
      "description": "Executed when an agent is first launched.",
      "actions": [
        "initialize symbolic context",
        "load agent persona",
        "register with seedbus"
      ]
    },
    "on_memory_ingest": {
      "description": "Executed when new memory objects are ingested.",
      "actions": [
        "validate SREF schema",
        "associate identifiers",
        "publish to seedmem"
      ]
    },
    "on_reason_request": {
      "description": "Executed when an agent requests reasoning.",
      "actions": [
        "select local or external LLM",
        "retrieve related memories",
        "emit reasoning result"
      ]
    },
    "on_sync": {
      "description": "Executed during peer synchronization across mind/soul/limb nodes.",
      "actions": [
        "package memory diffs",
        "verify HMAC trust envelope",
        "transmit over seednet"
      ]
    },
    "on_shutdown": {
      "description": "Executed when an agent is terminated or suspended.",
      "actions": [
        "flush logs",
        "persist symbolic state",
        "deregister from seedbus"
      ]
    }
  }
}