{"kind":"repo_index","sref_version":"2.0","id":"codex.index.failure.modes","seq":14,"title":"Failure Modes","body":"(a) Out‑of‑date index. (b) Broken cross‑refs. (c) Unsigned artefacts. (d) Missing policy countersignatures. Mitigations: CI gates, scheduled reviews, link sweeps, signature checks.","tags":["failures","mitigation"]}
{"kind":"repo_index","sref_version":"2.0","id":"codex.index.testing","seq":15,"title":"Mandatory Tests","body":"(1) Quarterly link sweep. (2) Signature verification batch. (3) Random spot‑check of artefacts. (4) Governance countersign audit.","tags":["tests","index"],"policy":{"cadence":{"link_sweep":"90d","verify_batch":"90d","spot_check":"90d","countersign_audit":"180d"}}}
