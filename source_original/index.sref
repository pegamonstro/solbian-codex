{"kind":"repo_index","sref_version":"2.0","id":"codex.index.maintenance","seq":12,"title":"Maintenance Policy","body":"Update this index when new artefacts are added or materially changed. Reflect updates in signing records; require countersignatures for policy/legal/security objects.","tags":["maintenance","policy"],"policy":{"review_cycle":"90d","countersignatures":">=2"}}
