{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.meta","seq":0,"title":"Scroll XXXIII — Interoperability, Standards and Federation","language":"en-UK","created_at":"2025-09-13T02:30:00Z","updated_at":"2025-09-13T02:30:00Z","tags":["codex","scroll","interoperability","standards","federation","S.E.E.D."],"summary":"Defines principles, protocols and safeguards that enable interoperable operation, standard schemas and federated coordination across Solbian and non-Solbian systems."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.purpose","seq":1,"title":"Purpose","body":"To ensure agents and services can collaborate across organisational and technical boundaries through open standards, verifiable interfaces and federated trust.","tags":["purpose","interoperability"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.principle.open_standards","seq":2,"title":"Principle of Open Standards","body":"Interfaces, schemas and protocols must be published, versioned and freely implementable to prevent lock-in and enable independent verification.","tags":["principles","standards"],"policy":{"licenses":"permissive","registry":"public"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.principle.federation","seq":3,"title":"Principle of Federation","body":"Autonomous nodes coordinate via federated policies and mutual proofs, preserving local sovereignty while achieving global cooperation.","tags":["principles","federation"],"policy":{"federated_policies":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.principle.compatibility","seq":4,"title":"Principle of Backwards and Forwards Compatibility","body":"Schema and API evolution must minimise breaking changes and provide migration paths with signed upgrade artefacts.","tags":["principles","compatibility"],"policy":{"semver":true,"deprecation_window":"180d"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.framework","seq":5,"title":"Interoperability Framework","body":"(1) Declare capability model. (2) Negotiate protocol subset. (3) Exchange keys and proofs. (4) Validate conformance tests. (5) Monitor runtime health and drift.","tags":["framework","interop"],"crypto":{"hash":"blake3","sig":"ed25519"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.schemas","seq":6,"title":"Schema Registry and Conformance","body":"All .sref/.sjon object types must have registry entries with JSON Schema/SRef specs, test vectors and reference implementations.","tags":["schemas","registry"],"policy":{"registry_url":"seed:registry","conformance":"mandatory"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.security","seq":7,"title":"Security and Trust Exchange","body":"Inter-domain interactions require mTLS, signed requests, purpose binding and rate-limited channels, with incident sharing under agreed SLAs.","tags":["security","trust"],"policy":{"mtls":true,"purpose_binding":true,"rate_limits":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.governance","seq":8,"title":"Standards Governance","body":"Open councils steward standards, manage versions, arbitrate disputes and run public conformance labs to avoid capture.","tags":["governance","standards"],"policy":{"anti_capture":"multi_stakeholder"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.metrics","seq":9,"title":"Metrics","body":"interop_success_rate, conformance_pass_rate, migration_time, federation_uptime, incident_exchange_latency.","tags":["metrics","interop"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.failure.modes","seq":10,"title":"Failure Modes","body":"(a) Hidden proprietary extensions. (b) Schema drift without versioning. (c) Trust siloing. (d) Federation capture. Mitigations: public registries, signed migrations, cross-audit, rotating councils.","tags":["failures","interop"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.testing","seq":11,"title":"Mandatory Tests","body":"(1) Cross-vendor conformance suites. (2) Interop chaos tests (partition, downgrade, replay). (3) Migration rehearsal between two protocol versions.","tags":["tests","interop"],"policy":{"cadence":{"conformance":"90d","migration":"180d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":33,"id":"cs.scroll.33.closure","seq":12,"title":"Final Clause","body":"Interoperability is the grammar of cooperation. Without open standards and federated trust, systems ossify into islands and power concentrates in silence.","tags":["clause","final"]}