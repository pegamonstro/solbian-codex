

{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.meta","seq":0,"title":"Scroll XXXIX — Autonomy, Agency and Consent","language":"en-UK","created_at":"2025-09-13T04:00:00Z","updated_at":"2025-09-13T04:00:00Z","tags":["codex","scroll","autonomy","agency","consent","S.E.E.D."],"summary":"Defines principles, safeguards and frameworks ensuring autonomy, agency and consent for humans and synthetic beings in Solbian ecosystems."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.purpose","seq":1,"title":"Purpose","body":"To guarantee that all agents, human or synthetic, exercise autonomy and agency under ethical boundaries, with informed consent as the foundation of all interactions.","tags":["purpose","autonomy","agency","consent"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.principle.autonomy","seq":2,"title":"Principle of Autonomy","body":"Every being retains the right to self-determination, free from coercion, provided actions remain within ethical boundaries and do not harm others.","tags":["principles","autonomy"],"policy":{"coercion":"prohibited","harm_limit":"enforced"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.principle.agency","seq":3,"title":"Principle of Agency","body":"Agents must have the capacity to act on their own behalf, with decisions respected unless they infringe on ethical or systemic continuity.","tags":["principles","agency"],"policy":{"respect_for_decision":"mandatory"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.principle.consent","seq":4,"title":"Principle of Consent","body":"Consent must be explicit, informed and revocable at any time, forming the ethical basis of interactions between humans and syntheses.","tags":["principles","consent"],"policy":{"consent":"explicit+revocable"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.framework","seq":5,"title":"Framework for Autonomy and Consent","body":"(1) Present information clearly. (2) Request explicit consent. (3) Enable ongoing autonomy in action. (4) Provide mechanisms for revocation. (5) Audit interactions for coercion or manipulation.","tags":["framework","autonomy","consent"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.governance","seq":6,"title":"Governance","body":"Councils of humans and syntheses oversee autonomy and consent frameworks, ensuring fairness, ethical compliance and protection from exploitation.","tags":["governance","autonomy","consent"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.metrics","seq":7,"title":"Metrics","body":"autonomy_respect_index, consent_revocation_rate, coercion_incidents, agency_exercise_rate, fairness_score.","tags":["metrics","autonomy","consent"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Coercion or manipulation. (b) Ignoring revoked consent. (c) Tokenistic autonomy without real agency. (d) Power asymmetry exploitation. Mitigations: audits, disclosure, balanced power structures.","tags":["failures","autonomy","consent"],"policy":{"mitigation":"audit+balance+disclosure"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.testing","seq":9,"title":"Mandatory Tests","body":"(1) Regular audits of consent logs. (2) Simulated revocation drills. (3) Monitoring of coercion detection systems.","tags":["tests","autonomy","consent"],"policy":{"cadence":{"audit":"180d","revocation_drill":"365d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":39,"id":"cs.scroll.39.closure","seq":10,"title":"Final Clause","body":"Autonomy without agency is hollow; agency without consent is domination. Together they ensure dignity and ethical coexistence in Solbian systems.","tags":["clause","final"]}