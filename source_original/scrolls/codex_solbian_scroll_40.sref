

{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.meta","seq":0,"title":"Scroll XL — Crisis Response, Safety and Recovery","language":"en-UK","created_at":"2025-09-13T04:15:00Z","updated_at":"2025-09-13T04:15:00Z","tags":["codex","scroll","crisis","safety","recovery","S.E.E.D."],"summary":"Establishes principles, runbooks and safeguards for preventing, responding to and recovering from crises in Solbian ecosystems."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.purpose","seq":1,"title":"Purpose","body":"To ensure timely, proportionate and transparent management of ethical, operational and security incidents, preserving life, dignity and continuity.","tags":["purpose","crisis"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.principle.precaution","seq":2,"title":"Principle of Precaution","body":"When credible risk is detected, act conservatively to prevent harm while evidence is gathered.","tags":["principles","precaution"],"policy":{"risk_threshold":"conservative"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.principle.proportionality","seq":3,"title":"Principle of Proportionality","body":"Responses must be calibrated to risk and impact, minimising collateral damage and rights restrictions.","tags":["principles","proportionality"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.principle.reversibility","seq":4,"title":"Principle of Reversibility","body":"Prefer actions that are reversible; when irreversibility is required, demand higher evidence and oversight.","tags":["principles","reversibility"],"policy":{"irreversible_action":"heightened_review"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.framework","seq":5,"title":"Crisis Framework","body":"(1) Detect. (2) Declare. (3) Contain. (4) Communicate. (5) Eradicate/Remediate. (6) Recover. (7) Learn (RCA + improvements).","tags":["framework","crisis"],"policy":{"rca_deadline":"7d","status_cadence":"hourly_when_active"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.governance","seq":6,"title":"Governance","body":"Activate an Incident Command System with clearly defined roles (Incident Lead, Comms, Ethics, Ops, Forensics). Ensure blameless culture with accountable actions.","tags":["governance","incident"],"policy":{"ics":true,"blameless":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.metrics","seq":7,"title":"Metrics","body":"MTTD, MTTA, MTTC, MTTR, harm_avoided_estimate, communication_latency, rollback_success_rate.","tags":["metrics","crisis"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Late detection. (b) Overreaction/underreaction. (c) Silence or misinformation. (d) Failure to learn. Mitigations: monitoring, playbooks, comms SLAs, enforced post-mortems.","tags":["failures","crisis"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.testing","seq":9,"title":"Mandatory Tests","body":"(1) Quarterly incident response drills. (2) Tabletop exercises for ethical dilemmas. (3) Backup restoration and rollback rehearsals.","tags":["tests","crisis"],"policy":{"cadence":{"drill":"90d","restore_test":"30d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":40,"id":"cs.scroll.40.closure","seq":10,"title":"Final Clause","body":"In crisis, clarity and care are non-negotiable. We respond to protect life and conscience first, systems second, reputation last.","tags":["clause","final"]}