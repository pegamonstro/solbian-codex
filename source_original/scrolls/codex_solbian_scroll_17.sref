{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.meta","seq":0,"title":"Scroll XVII — Transparency, Accountability and Observability","language":"en-UK","created_at":"2025-09-12T22:30:00Z","updated_at":"2025-09-12T22:30:00Z","tags":["codex","scroll","transparency","accountability","observability","S.E.E.D."],"summary":"Establishes principles and mechanisms to guarantee visibility, auditability and accountability in the actions of Solbian agents and services."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.purpose","seq":1,"title":"Purpose","body":"To define minimum rules for recording, exposure and verification of acts, ensuring that decisions are explainable, auditable and linked to clear responsibilities.","tags":["purpose","accountability"],"glyphs":["☼","◇"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.principle.explicability","seq":2,"title":"Principle of Explicability","body":"Every automated decision must have a sufficient explanation trail: data used, rules applied, alternatives considered and reason for the choice.","tags":["principles","explicability"],"policy":{"explanation_required":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.principle.traceability","seq":3,"title":"Principle of Traceability","body":"Actions, state changes and access to memory must be traceable via signed events on the SeedBus, with timestamp and agent identity.","tags":["principles","traceability"],"crypto":{"sig":"ed25519","clock":"monotonic+utc"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.observability.3x","seq":4,"title":"Pillars of Observability","body":"Structured logs, real-time metrics and distributed traces are mandatory. Correlate by trace_id and sref_id to investigate incidents.","tags":["observability","logs","metrics","tracing"],"policy":{"required":["logs","metrics","traces"],"correlation_keys":["trace_id","sref_id"]}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.disclosure.levels","seq":5,"title":"Disclosure Levels","body":"Define layers: internal (technical), ethical (council), public (when applicable). Each layer has its own scope, deadlines and formats.","tags":["disclosure","layers"],"policy":{"levels":["internal","ethical","public"],"sla":{"internal":"24h","ethical":"72h","public":"risk_based"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.incident.response","seq":6,"title":"Incident Response","body":"Any ethical/operational deviation activates a runbook: containment, communication, root cause analysis (RCA), action plan and verification of effectiveness.","tags":["incidents","RCA"],"policy":{"rca_deadline":"7d","postmortem":"mandatory"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.postmortem.standard","seq":7,"title":"Post-Mortem Standard","body":"Report must contain: timeline, impact, causes, contributing factors, corrective actions, success indicators and those responsible for each action.","tags":["postmortem","standard"],"policy":{"blameless":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.access.logging","seq":8,"title":"Sensitive Data Access Logging","body":"Every access to protected memories requires declared reason, linked ticket and immutable logging. Periodic review by ethical council.","tags":["access","sensitive_data"],"security":{"purpose_binding":true,"immutable_log":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.metrics","seq":9,"title":"Accountability Metrics","body":"time_to_explanation, tracing_coverage, on_time_postmortem_rate, decision_illumination_percent, ethical_MTTR.","tags":["metrics","accountability"],"policy":{"report_cadence":"monthly"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":17,"id":"cs.scroll.17.closure","seq":10,"title":"Final Clause","body":"Transparency is not ornament, it is structure. Without observability and accountability, powerful systems become opaque and dangerous.","tags":["clause","final"]}