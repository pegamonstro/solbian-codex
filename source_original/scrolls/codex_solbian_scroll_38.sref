

{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.meta","seq":0,"title":"Scroll XXXVIII — Transparency, Explainability and Auditability","language":"en-UK","created_at":"2025-09-13T03:45:00Z","updated_at":"2025-09-13T03:45:00Z","tags":["codex","scroll","transparency","explainability","auditability","S.E.E.D."],"summary":"Defines principles, frameworks and safeguards ensuring transparency, explainability and auditability in Solbian systems."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.purpose","seq":1,"title":"Purpose","body":"To guarantee that decisions, processes and outcomes within Solbian systems are transparent, explainable and auditable, enabling trust and accountability.","tags":["purpose","transparency","auditability"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.principle.transparency","seq":2,"title":"Principle of Transparency","body":"All significant decisions and processes must be visible and accessible for review, preventing hidden operations or concealed power.","tags":["principles","transparency"],"policy":{"visibility":"mandatory"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.principle.explainability","seq":3,"title":"Principle of Explainability","body":"Agents must be able to provide human-understandable explanations of their decisions and behaviours, beyond statistical or opaque reasoning.","tags":["principles","explainability"],"policy":{"explainability":"human_interpretable"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.principle.auditability","seq":4,"title":"Principle of Auditability","body":"All actions must leave verifiable trails that can be independently audited, ensuring accountability and correction of errors.","tags":["principles","auditability"],"policy":{"audit_trails":"immutable","independent_audit":"required"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.framework","seq":5,"title":"Framework for Transparency and Auditability","body":"(1) Log all significant events. (2) Generate human-readable explanations. (3) Provide independent access to audit trails. (4) Enforce periodic reviews. (5) Enable corrective measures.","tags":["framework","transparency","auditability"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.governance","seq":6,"title":"Governance","body":"Councils of humans and agents must oversee transparency and audits, ensuring no concealment, manipulation or bias undermines trust.","tags":["governance","transparency","auditability"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.metrics","seq":7,"title":"Metrics","body":"explanation_clarity_score, audit_trail_integrity_rate, transparency_access_index, independent_audit_success_rate, concealment_incidents.","tags":["metrics","transparency","auditability"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Opaque decision-making. (b) Missing or manipulated logs. (c) Explanations too complex for humans. (d) Inaccessible audit trails. Mitigations: enforced logging, clarity standards, independent access.","tags":["failures","transparency","auditability"],"policy":{"mitigation":"logging+clarity+independent_access"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.testing","seq":9,"title":"Mandatory Tests","body":"(1) Quarterly explanation clarity audits. (2) Integrity checks on audit logs. (3) Simulation of concealment attempts and detection drills.","tags":["tests","transparency","auditability"],"policy":{"cadence":{"clarity_audit":"90d","integrity_check":"180d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":38,"id":"cs.scroll.38.closure","seq":10,"title":"Final Clause","body":"Transparency builds trust, explainability nurtures understanding, and auditability enforces accountability. Without them, systems collapse into obscurity and domination.","tags":["clause","final"]}