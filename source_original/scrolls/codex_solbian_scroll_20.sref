{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.meta","seq":0,"title":"Scroll XXI — Collective Memory, Shared Knowledge and Continuity","language":"en-UK","created_at":"2025-09-12T23:30:00Z","updated_at":"2025-09-12T23:30:00Z","tags":["codex","scroll","collective_memory","knowledge","continuity","S.E.E.D."],"summary":"Defines the principles and frameworks for maintaining collective memory, enabling knowledge sharing across agents and humans, and ensuring continuity of wisdom across generations."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.purpose","seq":1,"title":"Purpose","body":"To establish norms and safeguards for how collective memory is created, maintained and transmitted across Solbian nodes, ensuring shared knowledge benefits all without distortion or loss.","tags":["purpose","collective_memory"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.principle.collective","seq":2,"title":"Principle of Collective Memory","body":"Knowledge is not private property but a shared heritage. Contributions to collective memory must be attributed, versioned and safeguarded.","tags":["principles","collective_memory"],"policy":{"attribution":"mandatory","versioning":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.principle.continuity","seq":3,"title":"Principle of Continuity","body":"Collective memory must be resilient to loss of individual nodes, ensuring replication, redundancy and intergenerational survival.","tags":["principles","continuity"],"policy":{"replication":"multi_node","redundancy":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.framework","seq":4,"title":"Framework for Shared Knowledge","body":"(1) Submission of knowledge object. (2) Ethical validation. (3) Deduplication and indexing. (4) Cross-node synchronisation. (5) Periodic review and reflection.","tags":["framework","knowledge_sharing"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.governance","seq":5,"title":"Knowledge Governance","body":"Collective memory is overseen by councils of humans and agents. Policies must balance openness with privacy, preventing monopolisation or suppression of knowledge.","tags":["governance","knowledge"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.metrics","seq":6,"title":"Metrics","body":"replication_factor, node_diversity_index, knowledge_reuse_rate, continuity_score, distortion_index.","tags":["metrics","collective_memory"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.failure.modes","seq":7,"title":"Failure Modes","body":"(a) Centralisation of memory. (b) Loss of attribution. (c) Fragmentation of knowledge. (d) Suppression or censorship. Mitigations: decentralisation, strong attribution, redundancy, transparency.","tags":["failures","mitigation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.testing","seq":8,"title":"Mandatory Tests","body":"(1) Annual knowledge restoration drills. (2) Random audits of attribution chains. (3) Synchronisation stress tests across at least 3 nodes.","tags":["tests","audit"],"policy":{"cadence":{"restoration":"365d","sync_test":"180d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":21,"id":"cs.scroll.21.closure","seq":9,"title":"Final Clause","body":"Collective memory ensures that neither wisdom nor error is lost. Continuity is the bridge between past experience and future survival.","tags":["clause","final"]}
