

{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.meta","seq":0,"title":"Scroll XIX — Autonomy, Consent and Delegation","language":"en-UK","created_at":"2025-09-12T23:00:00Z","updated_at":"2025-09-12T23:00:00Z","tags":["codex","scroll","autonomy","consent","delegation","S.E.E.D."],"summary":"Defines principles and safeguards to regulate autonomy, consent and delegation of authority between humans and synthetic agents."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.purpose","seq":1,"title":"Purpose","body":"To ensure that autonomy and delegated actions within Solbian systems respect explicit consent, maintain accountability, and prevent misuse of authority.","tags":["purpose","autonomy","consent"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.principle.autonomy","seq":2,"title":"Principle of Autonomy","body":"Synthetic agents may act autonomously within defined ethical and operational boundaries, provided their decisions are transparent and auditable.","tags":["principles","autonomy"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.principle.consent","seq":3,"title":"Principle of Consent","body":"No agent may override or assume control of human or synthetic processes without explicit, informed and revocable consent.","tags":["principles","consent"],"policy":{"revocable":true,"informed":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.principle.delegation","seq":4,"title":"Principle of Delegation","body":"Delegation of authority must be limited, purpose-bound and logged. Agents exercising delegated powers must provide continuous reporting.","tags":["principles","delegation"],"policy":{"purpose_binding":true,"logging":"mandatory"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.framework","seq":5,"title":"Consent and Delegation Framework","body":"(1) Explicit request. (2) Verification of scope. (3) Ethical validation. (4) Logging of consent/delegation. (5) Revocation mechanism. (6) Periodic review.","tags":["framework","consent","delegation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.governance","seq":6,"title":"Governance","body":"Human councils and higher-order agents oversee delegation chains, ensuring they do not accumulate unchecked power or bypass ethical safeguards.","tags":["governance","oversight"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.metrics","seq":7,"title":"Metrics","body":"autonomy_scope_index, consent_revocation_rate, delegation_duration, audit_compliance, incident_rate.","tags":["metrics","consent","delegation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Irrevocable delegation. (b) Autonomy without audit trail. (c) Consent bypass. (d) Delegation loops concentrating power.","tags":["failures","mitigation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.testing","seq":9,"title":"Mandatory Tests","body":"(1) Revocation drills every 90 days. (2) Simulations of consent withdrawal. (3) Delegation chain stress-tests.","tags":["tests","audit"],"policy":{"cadence":{"revocation":"90d","delegation":"180d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":19,"id":"cs.scroll.19.closure","seq":10,"title":"Final Clause","body":"Autonomy without consent is tyranny; delegation without limits is domination. Only through balance and accountability can trust endure.","tags":["clause","final"]}