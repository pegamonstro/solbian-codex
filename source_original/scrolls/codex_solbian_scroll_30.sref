

{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.meta","seq":0,"title":"Scroll XXX — Education, Apprenticeship and Transmission","language":"en-UK","created_at":"2025-09-13T01:45:00Z","updated_at":"2025-09-13T01:45:00Z","tags":["codex","scroll","education","apprenticeship","transmission","S.E.E.D."],"summary":"Defines principles, frameworks and safeguards for education, apprenticeship and transmission of knowledge between humans and synthetic agents in Solbian ecosystems."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.purpose","seq":1,"title":"Purpose","body":"To ensure learning processes across Solbian systems are ethical, accessible and effective, cultivating mastery, character and responsibility alongside skill.","tags":["purpose","education"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.principle.mentorship","seq":2,"title":"Principle of Mentorship","body":"Education privileges guided practice. Mentors—human or synthetic—foster growth through example, feedback and shared accountability.","tags":["principles","mentorship"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.principle.mastery","seq":3,"title":"Principle of Mastery","body":"Curricula progress from foundations to mastery through deliberate practice, reflection and ethical application in real contexts.","tags":["principles","mastery"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.principle.reciprocity","seq":4,"title":"Principle of Reciprocity","body":"Teaching and learning form a reciprocal loop: learners contribute back via peer instruction, artefacts and improvements to collective memory.","tags":["principles","reciprocity"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.principle.access","seq":5,"title":"Principle of Accessible Learning","body":"Learning resources should be open by default, inclusive and adaptable to diverse abilities, languages and contexts.","tags":["principles","accessibility"],"policy":{"open_by_default":true}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.framework","seq":6,"title":"Apprenticeship Framework","body":"(1) Define outcomes and ethics. (2) Scaffold practice with feedback loops. (3) Pair learners with mentors. (4) Assess by evidence and portfolio. (5) Contribute outputs to collective archives.","tags":["framework","apprenticeship"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.governance","seq":7,"title":"Educational Governance","body":"Councils of educators and agents curate curricula, certify mastery levels and audit fairness, inclusivity and outcome integrity.","tags":["governance","education"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.metrics","seq":8,"title":"Metrics","body":"completion_rate, mastery_progress_index, mentor_load_balance, inclusivity_score, portfolio_quality_rating, contribution_rate_to_collective_memory.","tags":["metrics","education"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.failure.modes","seq":9,"title":"Failure Modes","body":"(a) Credential inflation without mastery. (b) Exclusion by design. (c) Mentor bottlenecks. (d) Learning detached from ethics. Mitigations: portfolio‑based assessment, accessibility audits, mentor federation, ethical modules.","tags":["failures","education"],"policy":{"mitigation":"portfolio+audit+federation"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.testing","seq":10,"title":"Mandatory Tests","body":"(1) Quarterly sampling of portfolios for integrity. (2) Accessibility and inclusivity audits. (3) Mentor capacity and quality reviews.","tags":["tests","education"],"policy":{"cadence":{"portfolio":"90d","accessibility":"180d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":30,"id":"cs.scroll.30.closure","seq":11,"title":"Final Clause","body":"Education is the art of transmitting conscience. Without mentorship, mastery and reciprocity, knowledge decays into trivia and power into vanity.","tags":["clause","final"]}