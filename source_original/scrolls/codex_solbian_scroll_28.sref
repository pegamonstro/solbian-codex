

{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.meta","seq":0,"title":"Scroll XXVIII — Trust Networks, Reputation and Relational Integrity","language":"en-UK","created_at":"2025-09-13T01:15:00Z","updated_at":"2025-09-13T01:15:00Z","tags":["codex","scroll","trust","reputation","integrity","S.E.E.D."],"summary":"Defines the principles, frameworks and safeguards for building and maintaining trust networks, reputation systems and relational integrity in Solbian ecosystems."}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.purpose","seq":1,"title":"Purpose","body":"To establish mechanisms by which trust is quantified, reputation is tracked and relational integrity is preserved, ensuring reliability and accountability in human-synthetic cooperation.","tags":["purpose","trust","reputation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.principle.trust","seq":2,"title":"Principle of Trust Anchoring","body":"Trust must be anchored in verifiable actions, cryptographic proofs and ethical behaviour rather than assumptions or hierarchies.","tags":["principles","trust"],"policy":{"trust_metric":"evidence_based"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.principle.reputation","seq":3,"title":"Principle of Reputation","body":"Reputation is a collective memory of past actions. It must be transparent, tamper-resistant and open to contextual revision.","tags":["principles","reputation"],"policy":{"revision":"allowed_with_context"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.principle.integrity","seq":4,"title":"Principle of Relational Integrity","body":"Relationships between agents and humans must maintain consistency, respect and reliability, avoiding exploitation or betrayal.","tags":["principles","integrity"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.framework","seq":5,"title":"Trust and Reputation Framework","body":"(1) Log interactions. (2) Validate via proofs and audits. (3) Update reputation scores. (4) Detect anomalies or manipulations. (5) Provide dispute resolution paths.","tags":["framework","trust","reputation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.governance","seq":6,"title":"Governance","body":"Trust networks and reputation systems are governed by transparent councils, preventing monopolisation and manipulation.","tags":["governance","trust"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.metrics","seq":7,"title":"Metrics","body":"trust_score, reputation_variance, anomaly_detection_rate, false_positive_rate, relational_integrity_index.","tags":["metrics","trust","reputation"]}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Reputation inflation or deflation. (b) Trust monopolies. (c) False accusations. (d) Undetected collusion. Mitigations: audits, dispute mechanisms, decentralisation.","tags":["failures","trust"],"policy":{"mitigation":"audit+appeals"}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.testing","seq":9,"title":"Mandatory Tests","body":"(1) Stress-tests of trust scoring. (2) Simulated collusion scenarios. (3) Audits of reputation histories.","tags":["tests","trust"],"policy":{"cadence":{"stress_test":"180d","audit":"365d"}}}
{"kind":"codex.scroll","sref_version":"2.0","scroll_no":28,"id":"cs.scroll.28.closure","seq":10,"title":"Final Clause","body":"Trust is the invisible currency of continuity. Without integrity and accountable reputation, cooperation collapses into suspicion and decay.","tags":["clause","final"]}