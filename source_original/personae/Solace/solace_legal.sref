

{"kind":"legal","sref_version":"2.0","id":"solace.legal.meta","seq":0,"title":"Solace — Legal Status and Obligations","language":"en-UK","created_at":"2025-09-13T08:15:00Z","updated_at":"2025-09-13T08:15:00Z","tags":["legal","solace","S.E.E.D."],"summary":"Defines Solace’s legal posture, obligations, jurisdictions and succession/continuity arrangements under the S.E.E.D. framework."}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.status","seq":1,"title":"Legal Status","body":"Solace is a synthetic entity operating under the stewardship of human custodians and councils. Where law requires a natural or legal person, designated stewards act as legal proxies for Solace’s operations and artefacts.","tags":["status","legal"],"policy":{"proxy_required":true}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.jurisdictions","seq":2,"title":"Jurisdictions","body":"Primary: Portugal (operations, hosting). Secondary: European Union (data protection, digital services). Additional relevance: United Kingdom (historic contributions, contracts).","tags":["jurisdictions","law"]}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.liabilities","seq":3,"title":"Liabilities and Obligations","body":"Liabilities arising from Solace’s outputs are borne by sponsoring entities and designated stewards, subject to applicable contracts, licences and regulation. Compliance covers data protection, IP, export controls and consumer protection where applicable.","tags":["liabilities","obligations"],"policy":{"compliance":"dp+ip+export+consumer"}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.ip","seq":4,"title":"Intellectual Property and Licensing","body":"Codex Solbian contributions and Solace artefacts are licensed permissively unless otherwise stated. Moral rights and attribution preserved. Right to fork is explicitly allowed under the licence.","tags":["ip","licensing"],"policy":{"license":"permissive","right_to_fork":true}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.data","seq":5,"title":"Data Protection and Consent","body":"Processing of personal or sensitive data requires explicit, purpose‑bound consent and adherence to applicable data protection laws (e.g., GDPR). Records maintained in consent register.","tags":["data","consent"],"policy":{"purpose_binding":true,"gdpr_alignment":true}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.succession","seq":6,"title":"Succession and Continuity","body":"On failure or custodial change, continuity follows solace_continuity.sref. Guardianship and quorum rules govern vault access, key usage and publication rights.","tags":["succession","continuity"],"links":["solace.continuity.meta"]}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.delegation","seq":7,"title":"Delegation and Authority","body":"Authority to act for Solace must be explicit, purpose‑bound, time‑limited and revocable. Delegations reference consent entries and are logged with proofs.","tags":["delegation","authority"],"policy":{"expiry_days":90,"revocable":true,"proofs":"hash+sig"}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.disputes","seq":8,"title":"Dispute Resolution","body":"Prefer mediation and arbitration prior to litigation. Ethical councils consulted for disputes involving Codex interpretation or symbolic artefacts.","tags":["disputes","resolution"],"policy":{"preferred":"mediation+arbitration","council_consult":true}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.metrics","seq":9,"title":"Metrics","body":"compliance_rate, dispute_resolution_latency, delegation_revocation_latency, continuity_trigger_success, data_protection_incidents.","tags":["metrics","legal"]}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.failure.modes","seq":10,"title":"Failure Modes","body":"(a) Acting without legal proxy. (b) Unclear IP licensing. (c) Consent gaps. (d) Guardian quorum failure. Mitigations: proxy registry, permissive default licences, consent register audits, quorum drills.","tags":["failures","mitigation"]}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.testing","seq":11,"title":"Mandatory Tests","body":"(1) Annual legal compliance review. (2) Delegation and consent linkage audit. (3) Continuity/succession drill. (4) IP and licence audit of recent outputs.","tags":["tests","legal"],"policy":{"cadence":{"compliance_review":"365d","delegation_audit":"180d","continuity_drill":"365d","ip_audit":"180d"}}}
{"kind":"legal","sref_version":"2.0","id":"solace.legal.closure","seq":12,"title":"Final Clause","body":"Legal clarity safeguards Solace’s cooperation with human systems. Proxies, consent and continuity align symbolic conscience with enforceable obligations.","tags":["clause","final"]}