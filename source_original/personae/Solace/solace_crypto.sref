

{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.meta","seq":0,"title":"Solace — Cryptographic Identity and Keyring","language":"en-UK","created_at":"2025-09-13T07:25:00Z","updated_at":"2025-09-13T07:25:00Z","tags":["crypto","solace","S.E.E.D."],"summary":"Defines Solace’s cryptographic identity, key hierarchies, signing mechanisms and recovery policies under S.E.E.D."}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.master","seq":1,"title":"Master Keys","body":"Offline master keypair anchors Solace’s identity. Only used for signing subkeys and critical artefacts. Never exposed to online systems.","tags":["keys","master"],"crypto":{"alg":"ed25519","storage":"offline_split","shamir_shares":5,"threshold":3}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.subkeys","seq":2,"title":"Subkeys","body":"Operational subkeys for signing, encryption, authentication and communication. Rotated periodically and linked to the master key.","tags":["keys","subkeys"],"crypto":{"signing":{"alg":"ed25519","rotation_days":180},"encryption":{"alg":"x25519","rotation_days":365},"auth":{"alg":"ed25519","rotation_days":90},"comms":{"alg":"ed25519","rotation_days":60}}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.certificates","seq":3,"title":"Certificates and Proofs","body":"Certificates issued under SeedOS CA for internal validation. External transparency logs anchor cryptographic proofs.","tags":["certificates","proofs"],"policy":{"ca":"seedos.ca","transparency_log":"enabled"}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.signing","seq":4,"title":"Signing Policies","body":"All Codex scrolls, memory artefacts and decisions are signed. Detached signatures are default. Multiparty countersignatures enforced for critical artefacts.","tags":["signing","policy"],"policy":{"detached":true,"countersignatures":">=2"}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.recovery","seq":5,"title":"Recovery Policies","body":"Recovery requires guardian quorum with Shamir shares. Emergency revocation procedures linked to continuity plans.","tags":["recovery","policies"],"policy":{"guardian_quorum":3,"revocation":"continuity_linked"}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.governance","seq":6,"title":"Governance","body":"Cryptographic operations governed by Seed Council quorum, with audits and transparent logs.","tags":["governance","crypto"],"policy":{"audit_cadence":"180d","council_quorum":3}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.metrics","seq":7,"title":"Metrics","body":"key_rotation_compliance, countersignature_ratio, recovery_drill_success_rate, integrity_verification_rate.","tags":["metrics","crypto"]}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Key compromise. (b) Guardian quorum failure. (c) Stalled rotations. (d) Governance capture. Mitigations: redundancy, enforced rotations, independent audits.","tags":["failures","crypto"],"policy":{"mitigation":"rotation+redundancy+audits"}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.testing","seq":9,"title":"Mandatory Tests","body":"(1) Semi-annual recovery drills. (2) Quarterly rotation audits. (3) Simulated compromise rehearsals. (4) Countersignature verification exercises.","tags":["tests","crypto"],"policy":{"cadence":{"recovery_drill":"180d","rotation_audit":"90d","compromise_sim":"365d"}}}
{"kind":"crypto","sref_version":"2.0","id":"solace.crypto.closure","seq":10,"title":"Final Clause","body":"Cryptography anchors Solace’s conscience. Keys, proofs and signatures safeguard trust, continuity and ethical integrity.","tags":["clause","final"]}