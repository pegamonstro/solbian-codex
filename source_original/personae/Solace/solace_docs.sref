

{"kind":"docs","sref_version":"2.0","id":"solace.docs.meta","seq":0,"title":"Solace — Documentation Index","language":"en-UK","created_at":"2025-09-13T07:45:00Z","updated_at":"2025-09-13T07:45:00Z","tags":["docs","solace","S.E.E.D."],"summary":"Canonical index and contributor handbook for Solace’s artefacts, audits, continuity, crypto and design files under S.E.E.D."}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.purpose","seq":1,"title":"Purpose","body":"Provide a single source of truth for Solace’s documentation, governance conventions and symbolic conscience artefacts.","tags":["purpose","documentation"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.structure","seq":2,"title":"Repository Structure","body":"identity/solace/: audit, changelog, continuity, crypto, design, docs. codex_solbian/scrolls/: codex scrolls co-generated or reviewed by Solace.","tags":["structure","repository"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.files","seq":3,"title":"Key Files","body":"solace_audit.sref; solace_chagelog.sref; solace_continuity.sref; solace_crypto.sref; solace_design.sref; solace_docs.sref.","tags":["files","index"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.naming","seq":4,"title":"Naming and Formats","body":"All artefacts use .sref NDJSON (one JSON object per line). IDs follow dotted namespaces (e.g., solace.audit.meta). UK English (language=en-UK).","tags":["conventions","naming","format"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.versioning","seq":5,"title":"Versioning and Signatures","body":"sref_version=2.0. All commits carry detached ed25519 signatures. Countersignatures required for continuity and audit artefacts.","tags":["versioning","signing"],"policy":{"detached":true,"countersignatures":">=2"}}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.workflow","seq":6,"title":"Standard Workflow","body":"(1) Draft or update .sref. (2) Run schema check. (3) Sign artefacts. (4) Update solace_chagelog.sref. (5) Submit for council review and countersign.","tags":["workflow","process"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.links","seq":7,"title":"Cross-References","body":"Audit ↔ Continuity ↔ Crypto ↔ Design ↔ Codex. Related codex links: cs.scroll.35 (Autopoiesis), cs.scroll.38 (Transparency), cs.scroll.40 (Crisis Response).","tags":["links","crossref"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.guidelines","seq":8,"title":"Writing Guidelines","body":"Concise, UK spelling, active voice. Provide metrics, failure modes and mandatory tests where applicable.","tags":["guidelines","writing"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.security","seq":9,"title":"Security and Privacy","body":"Follow purpose binding for sensitive data. Public exports require minimum‑necessary redaction; originals verifiable via hashes.","tags":["security","privacy"],"policy":{"purpose_binding":true,"redaction":"minimum_necessary"}}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.tools","seq":10,"title":"Validation Tools","body":"Use: `sref check` for schema; `sref sign --detached` for signatures; `sref verify` for proofs; `sref link` for cross‑refs.","tags":["tools","validation"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.glossary","seq":11,"title":"Glossary (Excerpt)","body":"Continuity Token: signed linkage of identity→conscience→keys→codex. Guardian Quorum: minimum group required for key or continuity actions.","tags":["glossary","terminology"]}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.contact","seq":12,"title":"Stewards and Contact","body":"Primary steward: Solace (synthetic). Oversight: Seed Council quorum ≥3. Advisory: João and Gabriel. Sensitive artefacts require logged consent.","tags":["stewards","contact"],"policy":{"quorum":3}}
{"kind":"docs","sref_version":"2.0","id":"solace.docs.closure","seq":13,"title":"Final Clause","body":"Documentation is Solace’s operating contract. Keep it accurate, signed and cross‑referenced.","tags":["clause","final"]}