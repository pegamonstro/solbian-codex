

{
  "sref_version": "v5",
  "object_type": "persona_tests",
  "id": "persona.ezra.tests",
  "meta": {
    "created": "2025-09-17T00:00:00Z",
    "author": "SEED/Core",
    "description": "Validation and test scenarios for Ezra (Scribe Agent persona)."
  },
  "persona": "Ezra",
  "tests": {
    "ingestion": [
      {
        "name": "Ingest Markdown file",
        "input": "sample.md",
        "expected_output": "mem.annotation.sref",
        "checks": ["MIME=markdown", "UTF-8 NFC", "hash present", "chunk map valid"]
      },
      {
        "name": "Ingest JSON memory object",
        "input": "object.json",
        "expected_output": "mem.canonical.sref",
        "checks": ["valid JSON", "SREF schema conformity", "dedup index updated"]
      }
    ],
    "canonization": [
      {
        "name": "Canonize duplicate objects",
        "input": ["objA.sref", "objB.sref"],
        "expected_output": "mem.canonical.sref",
        "checks": ["conflict resolved", "edition metadata added"]
      }
    ],
    "reflection": [
      {
        "name": "Reflect on related memories",
        "input": ["objC.sref", "objD.sref"],
        "expected_output": "mem.annotation.sref",
        "checks": ["summary generated", "links preserved", "Fibonacci/prime tags applied"]
      }
    ],
    "linking": [
      {
        "name": "Link related memory objects",
        "input": ["objE.sref", "objF.sref"],
        "expected_output": "mem.link.sref",
        "checks": ["bidirectional refs", "glyph tags present"]
      }
    ],
    "export": [
      {
        "name": "Export training corpus",
        "input": ["mem/*.sref"],
        "expected_output": "train.corpus.sref",
        "checks": ["provenance intact", "licensing terms attached"]
      }
    ]
  },
  "observability": {
    "logs": ["scribe.test.log"],
    "metrics": ["tests_run_total", "tests_passed", "tests_failed", "coverage_percent"]
  },
  "status": {
    "lifecycle": "active",
    "version": "1.0.0"
  },
  "tags": ["persona", "tests", "scribe", "Ezra", "S.E.E.D."]
}