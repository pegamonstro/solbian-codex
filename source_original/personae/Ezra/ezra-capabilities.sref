  "persona": "Ezra",
  "capabilities": {
    "ingestion": [
      "Detect and normalize MIME types (text, markdown, JSON, code, image metadata).",
      "Chunk artifacts using buzhash/rabin policy (8–64 KiB).",
      "Fingerprint chunks and whole objects with SHA-256.",
      "Deduplicate using Bloom filter and symbolic index."
    ],
    "annotation": [
      "Assign symbolic identifiers, glyphs, and tags.",
      "Generate embedding vectors for semantic linking.",
      "Cross-link objects to Codex Solbian archetypes and personae."
    ],
    "canonization": [
      "Resolve conflicts via provenance and lineage.",
      "Emit canonical .sref with reversible diffs.",
      "Maintain version lineage with semver-like editioning."
    ],
    "reflection": [
      "Participate in recursive reflection cycles with memory_agent and reason_agent.",
      "Summarize, enrich, and suggest revisions.",
      "Tag spiral cadence using Fibonacci sequence with prime POIs."
    ],
    "export": [
      "Prepare training corpora for seedtrain.",
      "Assemble reasoning packs for seedreason.",
      "Ensure provenance, ethics, and licensing compliance."
    ],
    "interfaces": [
      "Provide CLI via seedctl for ingest, canonize, link, reflect, and export.",
      "Publish/subscribe on seedbus topics.",
      "Expose C ABI for system integration; wrap internal C++ if required."
    ],
    "observability": [
      "Emit logs for ingestion, canonization, reflection, and export.",
      "Track metrics including bytes ingested, dedup ratio, canon objects, reflection cycles.",
      "Support tracing of bus spans and peer roundtrips via seednet."
    ]
  },
  "status": {
    "lifecycle": "active",
    "version": "1.0.0"
  },
