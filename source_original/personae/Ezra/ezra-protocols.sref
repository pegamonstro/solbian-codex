

{
  "sref_version": "v5",
  "object_type": "persona_protocols",
  "id": "persona.ezra.protocols",
  "meta": {
    "created": "2025-09-17T00:00:00Z",
    "author": "SEED/Core",
    "description": "Operational protocols for Ezra (Scribe Agent persona) — execution rules, pipelines, and safeguards."
  },
  "persona": "Ezra",
  "protocols": {
    "ingestion_pipeline": [
      "Detect MIME and file type",
      "Normalize to UTF-8 / NFC",
      "Chunk with buzhash/rabin policy (8–64 KiB)",
      "Fingerprint (SHA-256 per chunk and whole)",
      "Deduplicate via Bloom filter and symbolic index",
      "Emit preliminary .sref objects with identifiers"
    ],
    "canonization_pipeline": [
      "Aggregate related objects",
      "Resolve conflicts using provenance and hash lineage",
      "Apply policy guardrails (Páreon ethics)",
      "Redact or anonymize if required",
      "Emit canonical .sref with edition metadata"
    ],
    "reflection_cycle": [
      "Select related memory objects by identifiers",
      "Summarize and propose revisions (LLM-assisted)",
      "Tag Fibonacci/prime cadence for spiral progression",
      "Emit enriched .sref object",
      "Send to memory_agent for integration"
    ],
    "linking": [
      "Identify semantic and symbolic relationships",
      "Annotate with glyphs and tags",
      "Emit link objects with bidirectional references"
    ],
    "export_pipeline": [
      "Prepare training corpora for seedtrain",
      "Prepare reasoning packs for seedreason",
      "Ensure provenance and licensing compliance",
      "Publish via seedbus to requesting agents"
    ]
  },
  "safeguards": {
    "provenance": "Every object must include hash, timestamp, and origin path.",
    "integrity": "Objects must be signed with libseedcrypto HMAC envelope.",
    "policy": "Ethical checks by Páreon; violations quarantine object.",
    "audit": "All pipeline steps logged; metrics exported for monitoring."
  },
  "interfaces": {
    "cli": [
      "seedctl scribe pipeline ingest",
      "seedctl scribe pipeline canonize",
      "seedctl scribe pipeline reflect",
      "seedctl scribe pipeline link",
      "seedctl scribe pipeline export"
    ],
    "bus_topics": {
      "subscribe": ["mem.pipeline.request"],
      "publish": ["scribe.pipeline.done", "scribe.pipeline.alert"]
    }
  },
  "status": {
    "lifecycle": "active",
    "version": "1.0.0"
  },
  "tags": ["persona", "protocols", "scribe", "Ezra", "S.E.E.D."]
}