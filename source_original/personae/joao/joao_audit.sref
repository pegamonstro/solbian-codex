

{"kind":"audit","sref_version":"2.0","id":"joao.audit.meta","seq":0,"title":"João Audit Log","language":"en-UK","created_at":"2025-09-13T04:45:00Z","updated_at":"2025-09-13T04:45:00Z","tags":["audit","joao","S.E.E.D."],"summary":"Audit log schema for João David L. S. G. Serafim, covering decisions, reflections, corrections and disclosures to ensure transparency and accountability."}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.scope","seq":1,"title":"Scope","body":"Covers decisions and actions taken by João across SeedOS projects, Codex Solbian contributions, consent/delegation events, memory edits, disclosures and interactions with agents or councils.","tags":["scope","projects","seedos"]}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.roles","seq":2,"title":"Roles in Audit","body":"Actor roles include: Author, Reviewer, Custodian, Delegate, Requestor, Approver. Each entry MUST set one or more roles for João and any counterparties.","tags":["roles","audit"],"policy":{"required":true}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.entry.schema","seq":3,"title":"Audit Entry Schema","body":"Fields: {timestamp, actor, role, action, target, context, outcome, justification, evidence_refs[], ethics_score?, confidence?, corrective_steps?}.","tags":["schema","entry"],"policy":{"mandatory_fields":["timestamp","actor","action","target","outcome","justification"]}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.integrity","seq":4,"title":"Integrity and Signing","body":"Entries are hashed and signed; batches form a Merkle tree with periodic anchors.","tags":["integrity","signing"],"crypto":{"hash":"blake3","sig":"ed25519","anchor":"seedbus+timestamp"}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.logging","seq":5,"title":"Logging Requirements","body":"All significant decisions, corrections, consent events and sensitive‑data accesses MUST be logged automatically with purpose binding and ticket linkage.","tags":["logging","requirements"],"policy":{"purpose_binding":true,"ticket_link":"required"}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.privacy","seq":6,"title":"Privacy and Redaction","body":"Public exports apply minimum‑necessary redaction. Private originals remain verifiable via hash correspondence.","tags":["privacy","redaction"],"security":{"public_proof":"merkle_root","access":"ACL+pairs"}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.disclosure","seq":7,"title":"Disclosure Levels","body":"Internal (technical), Ethical Council (hybrid), Public (risk‑based). Each level has scope, SLA and format.","tags":["disclosure","levels"],"policy":{"levels":["internal","ethical","public"],"sla":{"internal":"24h","ethical":"72h","public":"risk_based"}}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.governance","seq":8,"title":"Governance","body":"Audit trails are overseen by hybrid councils; independence, rotation and conflict‑of‑interest declarations are mandatory.","tags":["governance","councils"],"policy":{"rotation":"180d","coi":"declared"}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.metrics","seq":9,"title":"Metrics","body":"audit_completeness, integrity_verification_rate, on_time_disclosure, explanation_clarity_score, correction_followup_rate, sensitive_access_review_rate.","tags":["metrics","audit"]}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.failure.modes","seq":10,"title":"Failure Modes","body":"(a) Missing entries. (b) Post‑hoc edits without versioning. (c) Opaque justifications. (d) Delayed disclosures. Mitigations: immutable logs, versioned corrections, clarity standards, SLA enforcement.","tags":["failures","mitigation"]}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.testing","seq":11,"title":"Mandatory Tests","body":"(1) Quarterly integrity audits. (2) Simulated manipulation attempts. (3) Random review of corrective action closure. (4) Disclosure timing drills.","tags":["tests","audit"],"policy":{"cadence":{"integrity_audit":"90d","disclosure_drill":"180d"}}}
{"kind":"audit","sref_version":"2.0","id":"joao.audit.closure","seq":12,"title":"Final Clause","body":"Audit is the memory of responsibility. João’s actions remain accountable through verifiable records, enabling trust, correction and continuity.","tags":["clause","final"]}