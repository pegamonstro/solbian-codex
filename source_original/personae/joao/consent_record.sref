

{"kind":"consent","sref_version":"2.0","id":"joao.consent.meta","seq":0,"title":"João — Consent, Purpose Binding and Revocation Register","language":"en-UK","created_at":"2025-09-13T06:15:00Z","updated_at":"2025-09-13T06:15:00Z","tags":["consent","identity","S.E.E.D."],"summary":"Canonical register for recording consent, declared purposes, delegations and revocations related to João’s data, identity artefacts and operations."}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.scope","seq":1,"title":"Scope","body":"Covers processing of personal/symbolic data, project artefacts (Codex Solbian, SeedOS), cryptographic materials (under strict purpose binding), and operational actions executed by agents on João’s behalf.","tags":["scope","processing","purpose_binding"]}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.policy","seq":2,"title":"Consent Policy","body":"Consent must be explicit, informed, granular, time‑boxed and revocable without penalty. All uses are purpose‑bound and minimally necessary. Delegations inherit consent limits.","tags":["policy","consent"],"policy":{"explicit":true,"granular":true,"revocable":true,"expiry_days":90,"minimum_necessary":true}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.entry.schema","seq":3,"title":"Entry Schema","body":"Fields: {timestamp, subject, requester, action, purpose, scope, lawful_basis, data_classes[], delegation_id?, expiry?, constraints?, proof{hash,sig}, outcome, notes?}.","tags":["schema","entry"],"policy":{"mandatory_fields":["timestamp","subject","requester","action","purpose","scope","outcome"]},"crypto":{"hash":"blake3","sig":"ed25519"}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.types","seq":4,"title":"Consent Types and Actions","body":"Types: processing, disclosure, publication, storage, transfer, simulation, training. Actions: grant, deny, amend, revoke, renew.","tags":["types","actions"]}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.delegation","seq":5,"title":"Delegation Binding","body":"Any delegation must cite a consent entry ID, declare scope and limits, include start/expiry, and provide revocation mechanics. Execution requires dual‑control for high‑risk scopes.","tags":["delegation","binding"],"policy":{"dual_control":true,"high_risk":"security+finance+identity"}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.revocation","seq":6,"title":"Revocation and Amendments","body":"Revocations take effect immediately upon authenticated request. Systems must cease processing within SLA and propagate revocation to all processors and delegates.","tags":["revocation","amendment"],"policy":{"sla_stop_processing":"24h","propagation":"48h"}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.retention","seq":7,"title":"Retention and Minimisation","body":"Store only what is necessary for the stated purpose. Default retention equals purpose duration + audit window; thereafter redact or delete with proofs.","tags":["retention","minimisation"],"policy":{"audit_window_days":365,"redaction":"allowed","deletion_proof":"merkle_root"}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.records","seq":8,"title":"Example Records (Placeholders)","body":"(1) 2025‑09‑12T22:00Z grant → processing Codex edits by Solace; scope: translation & schema upgrade; expiry: 90d. (2) 2025‑09‑13T01:40Z grant → publication of scroll metadata to public repo; expiry: 365d.","tags":["examples","records"]}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.governance","seq":9,"title":"Governance","body":"Consent records overseen by Seed Council quorum (≥3). Disputes handled via mediation first. All accesses and edits are audited and countersigned for sensitive scopes.","tags":["governance","council"],"policy":{"quorum":3,"countersignatures":">=2"}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.metrics","seq":10,"title":"Metrics","body":"revocation_latency, propagation_success_rate, purpose_drift_incidents, consent_expiry_coverage, audit_trail_integrity.","tags":["metrics","consent"]}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.failure.modes","seq":11,"title":"Failure Modes","body":"(a) Purpose creep. (b) Lapsed consent. (c) Delegation without binding. (d) Revocation not propagated. Mitigations: purpose binding checks, expiry alerts, dual‑control, propagation audits.","tags":["failures","mitigation"]}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.testing","seq":12,"title":"Mandatory Tests","body":"(1) Quarterly revocation drills. (2) Purpose‑binding enforcement tests. (3) Expiry rollover audits. (4) Delegation linkage verification.","tags":["tests","consent"],"policy":{"cadence":{"revocation":"90d","expiry_audit":"90d"}}}
{"kind":"consent","sref_version":"2.0","id":"joao.consent.closure","seq":13,"title":"Final Clause","body":"Consent is living permission bound by purpose, time and dignity. Without faithful records and revocation, autonomy cannot endure.","tags":["clause","final"]}