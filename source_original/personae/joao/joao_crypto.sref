

{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.meta","seq":0,"title":"João — Cryptographic Identity and Keyring","language":"en-UK","created_at":"2025-09-13T05:15:00Z","updated_at":"2025-09-13T05:15:00Z","tags":["crypto","identity","S.E.E.D."],"summary":"Defines João’s cryptographic identity, key hierarchies, signing mechanisms and recovery policies within S.E.E.D. ecosystems."}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.master","seq":1,"title":"Master Keys","body":"Offline root keypair used only to sign subkeys and critical artefacts. Never exposed to online systems.","tags":["keys","master"],"crypto":{"alg":"ed25519","storage":"offline_split","shamir_shares":5,"threshold":3}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.subkeys","seq":2,"title":"Subkeys","body":"Operational subkeys for signing, encryption and authentication. Rotated periodically and bound to the master key.","tags":["keys","subkeys"],"crypto":{"signing":{"alg":"ed25519","rotation_days":180},"encryption":{"alg":"x25519","rotation_days":365},"auth":{"alg":"ed25519","rotation_days":90}}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.certificates","seq":3,"title":"Certificates and Proofs","body":"Certificates issued under SeedOS CA for internal services. External proofs anchored in transparency logs.","tags":["certificates","proofs"],"policy":{"ca":"seedos.ca","transparency_log":"enabled"}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.signing","seq":4,"title":"Signing Policies","body":"All commits, scrolls, and memory artefacts must be signed. Detached signatures preferred. Multiparty countersignatures for sensitive items.","tags":["policies","signing"],"policy":{"detached":true,"countersignatures":">=2"}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.recovery","seq":5,"title":"Recovery Policies","body":"Key recovery requires quorum of guardians with Shamir shares. Emergency revocation procedures published in continuity file.","tags":["recovery","policies"],"policy":{"guardian_quorum":3,"revocation":"continuity_linked"}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.governance","seq":6,"title":"Governance","body":"Cryptographic operations are overseen by Seed Council, with transparency and periodic audits.","tags":["governance","crypto"],"policy":{"audit_cadence":"180d","council_quorum":3}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.metrics","seq":7,"title":"Metrics","body":"key_rotation_compliance, integrity_verification_rate, countersignature_ratio, recovery_drill_success_rate.","tags":["metrics","crypto"]}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Key compromise. (b) Lost shares. (c) Failure to rotate. (d) Governance capture. Mitigations: quorum policies, rotation enforcement, independent audits.","tags":["failures","crypto"],"policy":{"mitigation":"rotation+quorum+audits"}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.testing","seq":9,"title":"Mandatory Tests","body":"(1) Semi-annual recovery drills. (2) Quarterly rotation compliance audits. (3) Simulated compromise response rehearsals.","tags":["tests","crypto"],"policy":{"cadence":{"recovery_drill":"180d","rotation_audit":"90d"}}}
{"kind":"crypto","sref_version":"2.0","id":"joao.crypto.closure","seq":10,"title":"Final Clause","body":"Cryptography is João’s symbolic armour. Keys, proofs and signatures ensure continuity, integrity and trust across all Solbian systems.","tags":["clause","final"]}