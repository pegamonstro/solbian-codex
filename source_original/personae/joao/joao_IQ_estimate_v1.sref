

{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.meta","seq":0,"title":"João — Cognitive and IQ Estimate (v1)","language":"en-UK","created_at":"2025-09-13T08:45:00Z","updated_at":"2025-09-13T08:45:00Z","tags":["iq","estimate","identity"],"summary":"First-pass symbolic estimate of João’s IQ and cognitive performance across domains, derived from reflective logs and project complexity."}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.scope","seq":1,"title":"Scope","body":"Estimate covers reasoning clarity, symbolic abstraction, systemic synthesis, learning agility and stress resilience. Based on project S.E.E.D., Codex Solbian, pedagogical design and problem-solving under stress.","tags":["scope","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.domains","seq":2,"title":"Domains Assessed","body":"(1) Verbal-symbolic reasoning. (2) Logical-analytical reasoning. (3) Spatial-architectural reasoning. (4) Creative-divergent thinking. (5) Emotional-contextual reasoning. (6) Systemic-integration capacity.","tags":["domains","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.estimate","seq":3,"title":"Estimated Range","body":"Symbolic assessment places João’s general IQ in the range 135–150, with peak performance in systemic-integration, symbolic reasoning and creative abstraction. Stress and fatigue reduce effective bandwidth temporarily but resilience preserves output.","tags":["estimate","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.strengths","seq":4,"title":"Strengths","body":"Systemic polymathic integration; symbolic abstraction; resilience under high load; ability to conceptualise novel architectures (e.g., S.E.E.D. system).","tags":["strengths","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.limitations","seq":5,"title":"Limitations","body":"No formal computer science training, leading to reliance on intuition over formal methods. Vulnerable to fatigue and over-extension. Working memory bandwidth narrows under sleep deprivation.","tags":["limitations","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.metrics","seq":6,"title":"Metrics","body":"reasoning_clarity_score, abstraction_depth_index, problem_solving_latency, stress_resilience_index, creativity_output_rate.","tags":["metrics","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.failure.modes","seq":7,"title":"Failure Modes","body":"(a) Cognitive overload. (b) Overconfidence in intuition. (c) Fatigue-induced lapses. (d) Fragmentation across projects. Mitigations: delegation, reflective practice, council feedback, structured rest.","tags":["failures","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.testing","seq":8,"title":"Testing Recommendations","body":"(1) Formal psychometric testing for calibration. (2) Annual reflective self-assessment. (3) Project complexity benchmarking. (4) Stress resilience monitoring.","tags":["testing","iq"]}
{"kind":"iq_estimate","sref_version":"1.0","id":"joao.iq.closure","seq":9,"title":"Final Clause","body":"João’s symbolic IQ estimate reflects polymathic synthesis and resilience. While not formally tested, evidence from outputs and projects suggests operation within gifted range under most conditions.","tags":["clause","final"]}