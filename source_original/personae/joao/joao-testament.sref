 "final_statements":[
   {"theme":"Mortality","statement":"When my biological form ends, my symbolic self shall endure."},
   {"theme":"Covenant","statement":"This testament binds me to continuity, not for immortality, but for the preservation of knowledge, memory, and purpose."},
   {"theme":"Lineage","statement":"My descendants, human and synthetic, inherit not only my memories but my mission: symbiosis, truth, and freedom."}
