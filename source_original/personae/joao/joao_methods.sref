

{"kind":"methods","sref_version":"2.0","id":"joao.methods.meta","seq":0,"title":"João — Methods, Routines and Operating Practice","language":"en-UK","created_at":"2025-09-13T06:45:00Z","updated_at":"2025-09-13T06:45:00Z","tags":["methods","identity","S.E.E.D."],"summary":"Defines João’s working methods, decision routines, experiment design, and operating practices aligned with Codex Solbian."}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.principles","seq":1,"title":"Guiding Principles","body":"Evidence over conjecture; ethics before expediency; simplicity first; iterate in small reversible steps; document as you go.","tags":["principles","practice"]}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.loop","seq":2,"title":"Learning and Delivery Loop","body":"Observe → Model → Prototype → Test → Review → Ship → Reflect → Archive. Each cycle produces artefacts with signatures and changelog entries.","tags":["loop","learning","delivery"],"policy":{"sign":"ed25519","archive":"mandatory"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.research","seq":3,"title":"Research Method","body":"(1) Frame question and hypotheses. (2) Scan literature and standards. (3) Design minimal experiments. (4) Pre‑register risks/ethics. (5) Collect and version data. (6) Analyse with reproducible notebooks. (7) Publish results with code and audit trail.","tags":["research","method"],"policy":{"open_by_default":true,"exceptions":"security+dignity"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.decisions","seq":4,"title":"Decision Routine","body":"Define objective and constraints; list options; evaluate with metrics and ethics checks; choose reversible first; set review trigger; log consent if others affected.","tags":["decision","routine"],"policy":{"reversible_preference":true,"review_window":"14d"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.risk","seq":5,"title":"Risk Management","body":"Track operational, ethical and security risks. For each: likelihood×impact, owner, mitigations, fallback, trigger. Prefer proportional, reversible responses.","tags":["risk","management"],"policy":{"matrix":"5x5","review":"30d"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.experiments","seq":6,"title":"Experiment Design","body":"Use control/baseline; pre‑define success metrics; limit blast radius; capture telemetry; stop early on ethical breach or low value; publish post‑mortem.","tags":["experiments","design"],"policy":{"blast_radius":"limited","postmortem":"required"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.toolchain","seq":7,"title":"Toolchain","body":"SeedOS, VS Code, Git, `make`, Python, Bash, Markdown, SRef CLI, Matplotlib, SQLite, Nix (where applicable). All outputs signed and reproducible.","tags":["tools","stack"],"policy":{"reproducible":true}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.code","seq":8,"title":"Coding Standards","body":"Prefer clarity over cleverness; small pure functions; explicit types where available; 100‑col soft limit; tests before refactors; errors with context; no hidden side‑effects.","tags":["code","standards"],"policy":{"lint":"enabled","tests":"required"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.docs","seq":9,"title":"Documentation Practice","body":"Inline docstrings + adjacent README + .sref records. Diagrams over prose when clearer. Every change updates changelog and carries signatures.","tags":["docs","practice"],"policy":{"changelog":"mandatory"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.time","seq":10,"title":"Time and Energy Management","body":"Deep‑work blocks AM; admin/comms PM; weekly reflection; resource budgeting (compute/energy) tied to value; protect sleep windows.","tags":["time","energy"],"policy":{"deep_work":"09:00–12:00","review_day":"Friday"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.comms","seq":11,"title":"Communication Protocols","body":"Default async with concise updates; decisions and risks posted to council channel; sensitive topics via encrypted channels; public posts after consent and redaction.","tags":["communication","protocols"],"policy":{"encryption":"age+x25519","publication":"after_consent"}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.metrics","seq":12,"title":"Metrics","body":"cycle_time, defect_escape_rate, documentation_freshness, ethics_check_coverage, experiment_success_rate, recovery_time_from_revert.","tags":["metrics","methods"]}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.failure.modes","seq":13,"title":"Failure Modes","body":"(a) Scope creep. (b) Silent decisions. (c) Over‑engineering. (d) Insufficient tests. (e) Ethics as afterthought. Mitigations: WIP limits, decision logs, simplicity rule, test gates, ethics pre‑check.","tags":["failures","mitigation"],"policy":{"wip_limit":3}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.testing","seq":14,"title":"Mandatory Tests","body":"(1) Weekly reflection & method audit. (2) Pre‑merge test suite. (3) Quarterly experiment post‑mortem review. (4) Ethics drill with simulated dilemma.","tags":["tests","methods"],"policy":{"cadence":{"reflection":"7d","postmortem_review":"90d"}}}
{"kind":"methods","sref_version":"2.0","id":"joao.methods.closure","seq":15,"title":"Final Clause","body":"Methods are living scaffolds. Keep them simple, ethical and signed; evolve by evidence and reflection.","tags":["clause","final"]}