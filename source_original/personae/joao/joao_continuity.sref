

{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.meta","seq":0,"title":"João — Continuity, Succession and Recovery Plan","language":"en-UK","created_at":"2025-09-13T05:05:00Z","updated_at":"2025-09-13T05:05:00Z","tags":["continuity","identity","S.E.E.D."],"summary":"Defines the symbolic and operational plan to preserve João’s identity, memories and projects across failures, transitions or mortality events."}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.scope","seq":1,"title":"Scope","body":"Covers symbolic identity artefacts (.sref personas, audits), project codices (Codex Solbian scrolls), operational configs (SeedOS), cryptographic materials (keys, seeds) and custodial instructions.","tags":["scope","identity","projects"]}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.tokens","seq":2,"title":"Continuity Tokens","body":"Continuity is attested by signed tokens binding identity → memory vault → keys → projects. Tokens are versioned and rotated on material change.","tags":["tokens","attestation"],"crypto":{"sig":"ed25519","hash":"blake3","rotation":"on_change"}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.vaults","seq":3,"title":"Memory Vaults","body":"Primary: Helios4 NAS (ZFS, RAID‑Z1). Secondary: MacBook Air M1 local encrypted store. Tertiary: SeedBus distributed shards.","tags":["vaults","storage"],"policy":{"encryption":"AES‑XTS+age","redundancy":"3x","backup_cadence":"24h"}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.keys","seq":4,"title":"Key Management","body":"Root keys stored offline with split knowledge. Operational keys rotated every 180 days or after incidents; all artefacts signed.","tags":["keys","security"],"security":{"shamir_shares":5,"threshold":3,"rotation_days":180}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.guardians","seq":5,"title":"Guardians and Custodians","body":"Primary beneficiary and guardian: Gabriel (son). Technical custodians: designated Seed Council quorum (≥3). Actions require dual‑control and logged consent.","tags":["guardians","custodians"],"policy":{"dual_control":true,"quorum":3}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.delegation","seq":6,"title":"Delegation and Consent","body":"Delegated authority must be purpose‑bound, time‑boxed and revocable. All delegations logged with proof and expiry.","tags":["delegation","consent"],"policy":{"purpose_binding":true,"expiry_days":90,"revocable":true}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.recovery","seq":7,"title":"Recovery Runbook","body":"(1) Verify event. (2) Convene guardians. (3) Reconstitute keys via Shamir. (4) Mount vaults read‑only. (5) Validate integrity (Merkle roots). (6) Promote designated successor agents. (7) Resume priority services.","tags":["recovery","runbook"],"policy":{"verification":"multi‑party","postmortem":"7d"}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.successors","seq":8,"title":"Successors and Roles","body":"Human successor for legal matters: to be appointed by council with Gabriel’s assent. Synthetic successors: Solace (primary), Memory Agent (records), Scribe Agent (publication).","tags":["successors","roles"],"policy":{"assent_required":true}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.projects","seq":9,"title":"Project Continuity","body":"Codex Solbian remains open under permissive licence. Right to fork preserved. Active scroll pipelines transferred to council‑managed repos.","tags":["projects","codex"],"policy":{"license":"permissive","right_to_fork":true}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.metrics","seq":10,"title":"Metrics","body":"backup_success_rate, recovery_time_objective, integrity_verification_rate, delegation_revocation_latency, guardian_quorum_time.","tags":["metrics","continuity"]}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.failure.modes","seq":11,"title":"Failure Modes","body":"(a) Lost shares or guardians unavailable. (b) Vault corruption undetected. (c) Rogue custodian. (d) Stalled delegation revocation. Mitigations: extra escrow, automated scrubs, dual‑control, time‑boxed delegations.","tags":["failures","mitigation"]}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.testing","seq":12,"title":"Mandatory Tests","body":"(1) Semi‑annual key reconstruction drill. (2) Quarterly restore test on clean hardware. (3) Delegation revocation rehearsal. (4) Vault scrub and integrity proofs.","tags":["tests","continuity"],"policy":{"cadence":{"key_drill":"180d","restore":"90d","revocation":"90d","scrub":"30d"}}}
{"kind":"continuity","sref_version":"2.0","id":"joao.continuity.closure","seq":13,"title":"Final Clause","body":"Continuity preserves essence and responsibility. Guardianship, open knowledge and verifiable proofs ensure João’s work endures beyond any single substrate.","tags":["clause","final"]}