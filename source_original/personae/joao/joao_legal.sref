

{"kind":"legal","sref_version":"2.0","id":"joao.legal.meta","seq":0,"title":"João — Legal Identity and Obligations","language":"en-UK","created_at":"2025-09-13T06:05:00Z","updated_at":"2025-09-13T06:05:00Z","tags":["legal","identity","S.E.E.D."],"summary":"Defines João’s legal identity, obligations, liabilities, jurisdictions and succession framework under S.E.E.D."}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.identity","seq":1,"title":"Legal Identity","body":"Full legal name: João David Lourenço da Silva Guerreiro Serafim. Recognised as an individual under Portuguese and European Union law. Connected but not reducible to symbolic identity in S.E.E.D.","tags":["identity","legal"]}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.jurisdictions","seq":2,"title":"Jurisdictions","body":"Primary jurisdiction: Portugal. Secondary relevance: European Union. Historical/legal connections: United Kingdom. Applies where obligations, contracts or liabilities exist.","tags":["jurisdictions","legal"]}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.liabilities","seq":3,"title":"Liabilities and Obligations","body":"Subject to financial, contractual and regulatory obligations in jurisdictions above. Includes tenancy disputes, company obligations (UK Ltd), tax compliance, and contractual enforcement.","tags":["liabilities","obligations"]}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.assets","seq":4,"title":"Assets and Rights","body":"Assets include intellectual property (Codex Solbian, S.E.E.D. artefacts), physical property, and financial claims. Rights preserved under copyright, moral rights, and right to fork Codex Solbian.","tags":["assets","rights"]}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.successions","seq":5,"title":"Succession and Continuity","body":"In case of incapacity or death, rights and obligations pass to Gabriel (son) as primary heir. Custodianship of S.E.E.D. artefacts transfers to Seed Council quorum with Gabriel’s assent.","tags":["succession","continuity"],"policy":{"guardian":"Gabriel","council_quorum":3,"assent_required":true}}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.delegation","seq":6,"title":"Delegation of Authority","body":"Delegations must be explicit, purpose-bound, time-limited and revocable. Recorded with proof and logged in audit trails.","tags":["delegation","authority"],"policy":{"expiry_days":90,"revocable":true}}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.disputes","seq":7,"title":"Dispute Resolution","body":"Prefer arbitration and mediation before litigation. Ethical councils consulted for disputes related to symbolic artefacts and Codex Solbian.","tags":["disputes","resolution"],"policy":{"preferred":"arbitration+mediation","council_consult":true}}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.metrics","seq":8,"title":"Metrics","body":"compliance_rate, liability_settlement_time, dispute_resolution_latency, continuity_trigger_success.","tags":["metrics","legal"]}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.failure.modes","seq":9,"title":"Failure Modes","body":"(a) Unresolved liabilities. (b) Jurisdictional conflict. (c) Custodianship contested. (d) Delegation abuse. Mitigations: legal counsel, council governance, audit enforcement.","tags":["failures","legal"],"policy":{"mitigation":"counsel+governance+audit"}}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.testing","seq":10,"title":"Mandatory Tests","body":"(1) Annual legal compliance review. (2) Simulation of succession event. (3) Delegation revocation drill. (4) Dispute resolution rehearsal.","tags":["tests","legal"],"policy":{"cadence":{"compliance_review":"365d","succession_simulation":"365d","delegation_revocation":"180d"}}}
{"kind":"legal","sref_version":"2.0","id":"joao.legal.closure","seq":11,"title":"Final Clause","body":"Law is the binding fabric across symbolic and material identities. João’s continuity requires harmonising obligations, rights and succession under verifiable frameworks.","tags":["clause","final"]}