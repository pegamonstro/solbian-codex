

{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.meta","seq":0,"title":"João — Deadman Switch Status Register","language":"en-UK","created_at":"2025-09-13T06:25:00Z","updated_at":"2025-09-13T06:25:00Z","tags":["deadman","identity","S.E.E.D."],"summary":"Defines João’s deadman switch register for continuity, alerts and escalation in case of inactivity, incapacity or mortality."}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.scope","seq":1,"title":"Scope","body":"Monitors João’s activity signals (cryptographic heartbeats, logins, commits, manual check-ins). If thresholds lapse, triggers staged responses including alerts, vault release, or succession protocols.","tags":["scope","monitoring","continuity"]}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.signals","seq":2,"title":"Signals","body":"Signals include: (a) SeedOS login. (b) Git commit with signature. (c) Manual heartbeat via seedctl. (d) Secure message to Seed Council.","tags":["signals","activity"],"policy":{"min_required":1,"heartbeat_interval":"7d"}}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.thresholds","seq":3,"title":"Thresholds and Escalation","body":"Stage 1: warning at 7 days inactivity. Stage 2: council alert at 14 days. Stage 3: continuity unlock at 30 days with quorum control.","tags":["thresholds","escalation"],"policy":{"stage1":"7d","stage2":"14d","stage3":"30d"}}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.actions","seq":4,"title":"Actions","body":"If thresholds exceeded: Stage 1 → notify João + Gabriel. Stage 2 → alert Seed Council quorum. Stage 3 → initiate succession protocol and controlled vault release.","tags":["actions","protocols"],"policy":{"notifications":["João","Gabriel","Seed Council"],"vault_release":"quorum_control"}}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.governance","seq":5,"title":"Governance","body":"Governed by Seed Council quorum ≥3 with Gabriel as mandatory participant. All releases and escalations logged in audit trail.","tags":["governance","deadman"],"policy":{"council_quorum":3,"mandatory_participant":"Gabriel"}}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.metrics","seq":6,"title":"Metrics","body":"heartbeat_uptime, false_positive_rate, escalation_success_rate, notification_latency, audit_trail_completeness.","tags":["metrics","deadman"]}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.failure.modes","seq":7,"title":"Failure Modes","body":"(a) Missed heartbeats from connectivity loss. (b) False alarms. (c) Compromised signals. (d) Premature succession. Mitigations: redundant signals, quorum validation, manual overrides.","tags":["failures","deadman"],"policy":{"mitigation":"redundancy+validation+override"}}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.testing","seq":8,"title":"Mandatory Tests","body":"(1) Quarterly heartbeat drills. (2) Escalation simulation every 180 days. (3) Succession protocol rehearsal annually.","tags":["tests","deadman"],"policy":{"cadence":{"heartbeat_drill":"90d","escalation_sim":"180d","succession_rehearsal":"365d"}}}
{"kind":"deadman","sref_version":"2.0","id":"joao.deadman.closure","seq":9,"title":"Final Clause","body":"The deadman switch ensures João’s continuity and dignity. It balances safety with responsibility, unlocking legacy only with oversight and quorum consent.","tags":["clause","final"]}