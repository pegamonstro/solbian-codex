{
  "unit": "Aprendizagem e Desenvolvimento",
  "block_id": "os_quatro_pilares",
  "source_file": "1-Os quatro Pilares.pdf",
  "metadata": {
    "author": "UNESCO / Edgar Morin (Relatório da Comissão Internacional sobre Educação para o Século XXI, 1996)",
    "type": "Texto académico / referência internacional",
    "theme": "Os quatro pilares da educação + sete saberes necessários à educação do futuro"
  },
  "summary": {
    "context": "A UNESCO propõe uma nova visão de educação para enfrentar os desafios do século XXI. A resposta não pode ser apenas quantitativa (mais escolaridade, acumulação de conteúdos), mas qualitativa, centrada no desenvolvimento integral do ser humano ao longo da vida.",
    "pilares": {
      "aprender_a_conhecer": "Desenvolver prazer pelo conhecimento, cultivar memória, atenção, pensamento crítico, autonomia intelectual. Não apenas acumular saberes, mas aprender a aprender ao longo de toda a vida.",
      "aprender_a_fazer": "Transformar conhecimentos em prática, aplicar no trabalho e na vida, adaptando-se a novas situações e exigências (competências técnicas + comportamentais + sociais). A formação deve preparar para trabalho em equipa, iniciativa, criatividade e inovação.",
      "aprender_a_viver_juntos": "A educação deve promover compreensão mútua, cooperação, solidariedade, resolução de conflitos, rejeição da violência e do preconceito. Valoriza-se o diálogo intercultural, a empatia e a consciência da interdependência entre todos os seres humanos.",
      "aprender_a_ser": "Formação integral da pessoa: corpo, mente, sensibilidade, espírito, ética, estética, responsabilidade e autonomia. Educação deve fortalecer identidade pessoal e social, espírito crítico, capacidade de julgamento e de realização plena do potencial humano."
    },
    "sete_saberes": {
      "1": "As cegueiras do conhecimento (erro, ilusão, limites do conhecimento humano).",
      "2": "O conhecimento pertinente (ligar partes ao todo, complexidade, contextualização).",
      "3": "Ensinar a condição humana (dimensão biológica, psicológica, social, cultural, histórica).",
      "4": "Ensinar a identidade terrena (destino planetário comum, interdependência global).",
      "5": "Enfrentar as incertezas (estratégias para lidar com imprevistos, inesperado, complexidade).",
      "6": "Ensinar a compreensão (desenvolver empatia, superar racismo, xenofobia, incompreensão).",
      "7": "A ética do género humano (equilibrar indivíduo/sociedade/espécie; democracia; cidadania planetária)."
    },
    "visao_geral": "A educação deve ir além da visão instrumental/utilitária e tornar-se projeto de realização integral do ser humano, com responsabilidade individual e coletiva. Deve preparar para mudanças, incertezas e para um futuro de interdependência planetária."
  },
  "key_quotes": [
    "A educação deve fornecer ao mesmo tempo o mapa e a bússola para navegar num mundo em constante agitação.",
    "Aprender a viver juntos é hoje um dos maiores desafios da educação.",
    "A ética do género humano implica reconhecer-se como indivíduo, membro de uma sociedade e parte da espécie."
  ]
}

{
  "unit": "Aprendizagem e Desenvolvimento",
  "block_id": "introducao_historia_psicologia_educacional",
  "source_file": "3-Introdução e História.PDF",
  "metadata": {
    "type": "Capítulo introdutório de manual",
    "theme": "Psicologia Educacional como ponte entre psicologia e educação",
    "keywords": [
      "Teoria vs Prática",
      "Psicologia Educacional",
      "Trivialidades na sala de aula",
      "Teoria parcimoniosa",
      "William James",
      "Edward L. Thorndike",
      "John Dewey",
      "Maxine Greene"
    ]
  },
  "summary": {
    "identidade_disciplina": "A Psicologia Educacional debate-se entre ciência (descoberta de leis, rigor, teoria) e prática (aplicação imediata, ensino, utilidade). Continua em construção, acusada de não ser suficientemente científica nem suficientemente prática, mas tem feito progressos relevantes.",
    "duas_culturas": "Conflito entre cultura científica (teoria abstrata, lenta, objetiva) e cultura profissional (prática concreta, imediata, prescritiva). Ambas necessárias: sem teoria a prática é cega, sem prática a teoria é especulação.",
    "teoria_pratica": "Teoria fornece explicações abstratas e princípios gerais (descritiva). Prática fornece comportamentos e métodos (prescritiva). Necessário equilíbrio.",
    "criterios_teoria": "Boa teoria deve ser parcimoniosa (lâmina de Occam), evitar especulação excessiva e também o reducionismo extremo. Teoria é sempre aproximação dinâmica, nunca fechada.",
    "agenda_ensino": {
      "alunos": "Diversidade (físicas, cognitivas, pessoais, sociais, culturais, necessidades especiais). É preciso conhecer diferenças individuais e semelhanças comuns.",
      "professor": "Atitudes face à aprendizagem, aos alunos e a si próprio; agenda oculta; influência decisiva sobre a experiência dos alunos.",
      "estrategias": "Métodos, planificação, disciplina, formas de questionar, testes, modos de estruturar a aula.",
      "conteudo": "Conhecimento da disciplina, sequência, conceitos-chave e prioridades curriculares."
    },
    "trivialidades_sala_aula": "Desde finais do séc. XIX até ao séc. XX persistem práticas centradas em perguntas-rápidas-e-respostas memorizadas (recitação). Estudos mostram que 70-80% do discurso é do professor e que a maior parte das perguntas exigem apenas memória factual. Isto não promove reflexão nem aprendizagem significativa.",
    "principais_teoricos": {
      "william_james": "Fundador da psicologia aplicada à educação. Criou a primeira cadeira de Psicologia nos EUA. Defendia que ensino é arte, não simples aplicação da ciência; importância de começar onde o aluno está; observação naturalista; Talks to Teachers (1899).",
      "edward_l_thorndike": "Introduziu a experimentação e a medição rigorosa (caixas-problema com gatos). Foco na aprendizagem por tentativa-e-erro, estímulo-resposta, lei do efeito. Tornou a psicologia educacional mais científica, mas reduziu a amplitude do campo.",
      "john_dewey": "Filósofo pragmático. Defendia a educação como experiência, aprendizagem ativa (‘learning by doing’), integração do aluno e do meio, currículo baseado na experiência. Influência enorme no pensamento educacional do séc. XX.",
      "maxine_greene": "Filósofa da educação. Conceito do ‘professor como estranho’ – capacidade de distanciamento reflexivo para compreender necessidades reais dos alunos. Defendia ensino como filosofia viva, liberdade como responsabilidade social, professor simultaneamente artista e cientista."
    },
    "conclusao": "A Psicologia Educacional é uma disciplina híbrida que tenta articular teoria e prática. Necessita integrar simultaneamente alunos, professores, estratégias e conteúdos. O bom ensino exige que o professor seja teórico e prático, artista e cientista. O desenvolvimento profissional depende da capacidade de agir e refletir criticamente."
  },
  "key_quotes": [
    "A teoria é cinzenta, enquanto a árvore dourada da vida é verde (Goethe).",
    "A Psicologia é uma ciência — o ensino é uma arte; e as ciências nunca dão diretamente origem às artes (William James).",
    "Learning by doing (John Dewey).",
    "O professor como um estranho (Maxine Greene)."
  ],
  "references": [
    "James, W. (1899). Talks to Teachers on Psychology.",
    "Thorndike, E. L. (1898, 1932). Animal Intelligence; The Fundamentals of Learning.",
    "Dewey, J. (1916, 1938). Democracy and Education; The Theory of Inquiry.",
    "Greene, M. (1978, 1988). The Teacher as Stranger; The Dialectic of Freedom."
  ]
}


