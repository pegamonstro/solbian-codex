

{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.meta","seq":0,"title":"João — Guardian and Custodian Registry","language":"en-UK","created_at":"2025-09-13T06:35:00Z","updated_at":"2025-09-13T06:35:00Z","tags":["guardians","custodians","S.E.E.D."],"summary":"Canonical registry of guardians and custodians empowered to act for João under continuity, consent and recovery policies."}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.scope","seq":1,"title":"Scope","body":"Defines authorised humans and agents, roles, contact points, key‑share holdings, quorum rules and rotation for continuity, consent and deadman procedures.","tags":["scope","continuity","consent"]}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.roles","seq":2,"title":"Roles and Authorities","body":"Roles: Guardian (human beneficiary), Custodian (technical operations), Council Member (governance), Auditor (oversight). Authorities are purpose‑bound, time‑boxed and revocable.","tags":["roles","authority"],"policy":{"purpose_binding":true,"time_boxed":true,"revocable":true}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.schema","seq":3,"title":"Entry Schema","body":"Fields: {id, name, type(human|agent), role[], contact, pubkey, share_id?, share_threshold?, start, expiry?, notes}.","tags":["schema","registry"],"policy":{"mandatory_fields":["id","name","type","role","pubkey","start"]}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.quorum","seq":4,"title":"Quorum Policy","body":"Actions requiring quorum: key recovery, vault access, succession, high‑risk delegations. Minimum quorum: 3 including Gabriel for succession triggers.","tags":["quorum","policy"],"policy":{"min_quorum":3,"mandatory_participant":"Gabriel"}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.rotation","seq":5,"title":"Rotation and Review","body":"Guardianship reviewed every 180 days. Rotation or removal requires council decision and logged consent. Lost contact → provisional suspension after 30 days.","tags":["rotation","review"],"policy":{"review_cycle":"180d","suspension":"30d"}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.contacts","seq":6,"title":"Contact Protocols","body":"Primary contact via encrypted channel (age/x25519). Escalation: phone/SMS fallback, then physical welfare check via trusted local. All attempts logged.","tags":["contact","protocols"],"policy":{"encryption":"age+x25519","logging":"mandatory"}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.entries","seq":7,"title":"Registered Guardians (Placeholders)","body":"G1: Gabriel — type: human — roles: Guardian — pubkey: ed25519:gabriel_pub — share_id: S1. G2: Seed Council Quorum — type: human collective — roles: Custodian,Council — pubkey: ed25519:seed_council_pub — share_id: S2,S3. G3: Solace — type: agent — roles: Custodian (advisory), Auditor (logs) — pubkey: ed25519:solace_pub — no share.","tags":["entries","registry"]}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.boundaries","seq":8,"title":"Boundaries and Safeguards","body":"No unilateral access to private materials. All high‑risk actions require dual‑control + audit trail. Public releases follow consent and redaction policies.","tags":["boundaries","safeguards"],"policy":{"dual_control":true,"audit_trail":"immutable"}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.metrics","seq":9,"title":"Metrics","body":"contact_uptime, quorum_formation_latency, rotation_compliance, audit_log_integrity, incident_false_positive_rate.","tags":["metrics","guardians"]}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.failure.modes","seq":10,"title":"Failure Modes","body":"(a) Guardian unreachable. (b) Key‑share loss. (c) Role confusion. (d) Collusion or capture. Mitigations: redundancy, clear runbooks, independent audits, rotation and diversity.","tags":["failures","mitigation"]}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.testing","seq":11,"title":"Mandatory Tests","body":"(1) Semi‑annual quorum assembly drill. (2) Key‑share reconstruction rehearsal. (3) Contact protocol test. (4) Audit of role/authority mappings.","tags":["tests","guardians"],"policy":{"cadence":{"quorum":"180d","reconstruction":"180d","contact":"90d"}}}
{"kind":"guardians","sref_version":"2.0","id":"joao.guardians.closure","seq":12,"title":"Final Clause","body":"Guardianship is stewardship. Power is constrained by purpose, time and proof. All actions must serve continuity, dignity and consent.","tags":["clause","final"]}