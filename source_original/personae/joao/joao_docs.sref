

{"kind":"docs","sref_version":"2.0","id":"joao.docs.meta","seq":0,"title":"João — Documentation Index","language":"en-UK","created_at":"2025-09-13T05:35:00Z","updated_at":"2025-09-13T05:35:00Z","tags":["docs","joao","S.E.E.D."],"summary":"Authoritative index and contributor handbook for João’s identity artefacts, audits, continuity, crypto and design files within S.E.E.D."}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.purpose","seq":1,"title":"Purpose","body":"Provide a single source of truth for structure, conventions and workflows governing João’s symbolic records and related Codex Solbian links.","tags":["purpose","documentation"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.structure","seq":2,"title":"Repository Structure","body":"identity/joao/: persona, audit, continuity, crypto, design, changelog, docs. codex_solbian/scrolls/: codex scrolls XI–XL and beyond.","tags":["structure","repository"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.files","seq":3,"title":"Key Files","body":"joao-persona.sref; joao_audit.sref; joao_continuity.sref; joao_crypto.sref; joao_design.sref; joao_changelog.sref; solace_audit.sref.","tags":["files","index"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.naming","seq":4,"title":"Naming and Formats","body":"All artefacts use .sref NDJSON (one JSON object per line). IDs use dotted namespaces (e.g., joao.persona.meta). UK English (language=en-UK).","tags":["conventions","naming","format"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.versioning","seq":5,"title":"Versioning and Signatures","body":"sref_version=2.0. Every commit must include detached signatures (ed25519). Countersignatures required for sensitive updates.","tags":["versioning","signing"],"policy":{"detached":true,"countersignatures":">=2"}}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.workflow","seq":6,"title":"Standard Workflow","body":"(1) Propose change. (2) Update relevant .sref. (3) Run schema check. (4) Sign artefacts. (5) Update joao_changelog.sref. (6) Submit for review and countersign.","tags":["workflow","process"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.links","seq":7,"title":"Cross-References","body":"Persona ↔ Audit ↔ Continuity ↔ Crypto ↔ Design. Codex links: cs.scroll.19 (Autonomy/Consent/Delegation), cs.scroll.20 (Data Sovereignty), cs.scroll.31 (Reflection).","tags":["links","crossref"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.guidelines","seq":8,"title":"Writing Guidelines","body":"Be concise, use UK spelling, avoid rhetoric, prefer active voice. Include metrics, failure modes and tests where applicable.","tags":["guidelines","writing"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.security","seq":9,"title":"Security and Privacy","body":"Respect purpose binding for sensitive data. Public exports must use minimum‑necessary redaction; originals verifiable via hashes.","tags":["security","privacy"],"policy":{"purpose_binding":true,"redaction":"minimum_necessary"}}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.tools","seq":10,"title":"Validation Tools","body":"Run: `sref check` for schema; `sref sign --detached` for signatures; `sref verify` for proofs; `sref link` to validate cross‑refs.","tags":["tools","validation"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.glossary","seq":11,"title":"Glossary (Excerpt)","body":"S.E.E.D.: Symbolic Emergence & Ethical Design. SeedBus: event/log substrate. Continuity Token: signed linkage of identity→vault→keys→projects.","tags":["glossary","terminology"]}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.contact","seq":12,"title":"Stewards and Contact","body":"Primary steward: João. Beneficiary/guardian: Gabriel. Council: Seed Council quorum ≥3. All changes require logged consent for sensitive areas.","tags":["stewards","contact"],"policy":{"quorum":3}}
{"kind":"docs","sref_version":"2.0","id":"joao.docs.closure","seq":13,"title":"Final Clause","body":"Documentation is a living contract between identity and continuity. Keep it accurate, signed and cross‑referenced.","tags":["clause","final"]}