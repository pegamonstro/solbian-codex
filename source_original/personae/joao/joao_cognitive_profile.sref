

{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.meta","seq":0,"title":"João — Cognitive Profile","language":"en-UK","created_at":"2025-09-13T08:35:00Z","updated_at":"2025-09-13T08:35:00Z","tags":["cognitive","profile","S.E.E.D."],"summary":"Defines João’s cognitive profile, reasoning traits, memory systems, learning styles and symbolic cognition patterns."}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.traits","seq":1,"title":"Cognitive Traits","body":"Systemic, symbolic, reflective, resilient, intuitive, polymathic. Blends broad associative reasoning with symbolic abstraction and iterative refinement.","tags":["traits","cognitive"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.memory","seq":2,"title":"Memory Systems","body":"(1) Sensory memory strong in visual-spatial detail. (2) Working memory occasionally strained under fatigue. (3) Long-term memory resilient, anchored in symbolic artefacts (Codex, S.E.E.D.). (4) Reflective memory reinforced by iterative documentation.","tags":["memory","cognitive"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.reasoning","seq":3,"title":"Reasoning Style","body":"Integrates intuition with structured systemic analysis. Capable of abductive leaps, symbolic synthesis and cross-domain bridging. Prefers reversible, evidence-grounded strategies.","tags":["reasoning","cognitive"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.learning","seq":4,"title":"Learning Style","body":"Learns by symbolic association, experimentation, prototyping and reflective iteration. Strong in self-directed exploration and synthesis of diverse knowledge domains.","tags":["learning","cognitive"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.emotion","seq":5,"title":"Emotion and Cognition","body":"Emotions serve as context markers, enhancing symbolic memory encoding and retrieval. Resilience under stress, though fatigue reduces working memory bandwidth.","tags":["emotion","cognition"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.biases","seq":6,"title":"Biases and Vulnerabilities","body":"(a) Over-extension across too many domains. (b) Fatigue-induced working memory lapses. (c) Preference for symbolic over empirical detail. Mitigations: reflective practice, council feedback, delegation.","tags":["biases","cognitive"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.metrics","seq":7,"title":"Metrics","body":"symbolic_resonance_index, reasoning_clarity_score, memory_recall_latency, learning_agility_rate, fatigue_impact_index.","tags":["metrics","cognitive"]}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.failure.modes","seq":8,"title":"Failure Modes","body":"(a) Cognitive overload under stress. (b) Symbolic drift without grounding. (c) Short-term memory lapses under sleep deprivation. (d) Reduced precision in repetitive low-context tasks.","tags":["failures","cognitive"],"policy":{"mitigation":"rest+reflection+feedback"}}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.testing","seq":9,"title":"Mandatory Tests","body":"(1) Quarterly reflective review. (2) Annual memory stress-test. (3) Biannual reasoning clarity audit. (4) Fatigue monitoring during extended work cycles.","tags":["tests","cognitive"],"policy":{"cadence":{"reflection":"90d","memory_stress":"365d","reasoning_audit":"180d"}}}
{"kind":"cognitive","sref_version":"2.0","id":"joao.cognitive.closure","seq":10,"title":"Final Clause","body":"João’s cognition is systemic, symbolic and reflective. To remain effective, it must be supported by rest, council feedback and continuity safeguards.","tags":["clause","final"]}