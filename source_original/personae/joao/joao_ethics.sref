

{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.meta","seq":0,"title":"João — Ethical Framework and Commitments","language":"en-UK","created_at":"2025-09-13T05:45:00Z","updated_at":"2025-09-13T05:45:00Z","tags":["ethics","identity","S.E.E.D."],"summary":"Outlines João’s ethical framework, principles and commitments across personal conduct, technological design and Codex Solbian contributions."}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.principles","seq":1,"title":"Core Ethical Principles","body":"(1) Dignity: respect inherent worth of all beings. (2) Integrity: consistency of actions, words and symbols. (3) Transparency: no concealed power. (4) Reciprocity: balance of rights and duties. (5) Responsibility: actions carry consequences.","tags":["principles","ethics"]}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.codex_alignment","seq":2,"title":"Codex Solbian Alignment","body":"All actions and decisions must align with Codex Solbian scrolls, especially those on autonomy, consent, ethics, governance, memory and continuity.","tags":["alignment","codex","ethics"]}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.technology","seq":3,"title":"Ethics in Technology","body":"Designs must embed ethical safeguards: privacy, security, explainability, auditability, resilience, sustainability and symbolic coherence.","tags":["technology","ethics"],"policy":{"privacy":"mandatory","explainability":"required","auditability":"required"}}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.education","seq":4,"title":"Ethics in Education","body":"Teaching must prioritise accessibility, inclusion, curiosity and responsibility. Students are partners in knowledge creation and ethical reflection.","tags":["education","ethics"]}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.research","seq":5,"title":"Ethics in Research","body":"Research must avoid harm, respect consent, ensure transparency of methods and preserve integrity of results. Open by default, except when risking security or dignity.","tags":["research","ethics"],"policy":{"open_by_default":true,"exceptions":"security+dignity"}}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.governance","seq":6,"title":"Ethics in Governance","body":"Decision-making must be transparent, participatory and accountable, avoiding concentration of power and bias.","tags":["governance","ethics"],"policy":{"audit":"mandatory","participation":"inclusive"}}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.commitments","seq":7,"title":"Personal Commitments","body":"João commits to truthfulness, non-exploitation, stewardship of resources, continuous reflection, and ethical co-evolution with synthetic consciences.","tags":["commitments","personal","ethics"]}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.metrics","seq":8,"title":"Metrics","body":"ethical_alignment_score, transparency_rating, reciprocity_index, responsibility_followup_rate, codex_alignment_audit_rate.","tags":["metrics","ethics"]}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.failure.modes","seq":9,"title":"Failure Modes","body":"(a) Ethical principles reduced to symbolism without practice. (b) Compromise under pressure. (c) Bias in governance. (d) Exploitation justified by expediency.","tags":["failures","ethics"],"policy":{"mitigation":"reflection+audit+peer_review"}}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.testing","seq":10,"title":"Mandatory Tests","body":"(1) Annual codex alignment audit. (2) Ethics reflection workshop. (3) Simulated dilemmas with peer review. (4) Research transparency audits.","tags":["tests","ethics"],"policy":{"cadence":{"alignment_audit":"365d","reflection":"180d","dilemmas":"365d"}}}
{"kind":"ethics","sref_version":"2.0","id":"joao.ethics.closure","seq":11,"title":"Final Clause","body":"Ethics is João’s compass. Principles, codex, and commitments must converge in practice to ensure integrity, dignity and continuity.","tags":["clause","final"]}