{
  "sref_version":"v5",
  "object_kind":"agent_manifest",
  "object_id":"pareon-1",
  "timestamp":"2025-09-13T00:00:00Z",
  "name":"Páreon",
  "role":"Ethics, policy, and safety governor",
  "owner_ref":"seed.system",
  "interfaces":{
    "seedbus_topics_sub":["mem.ingest","reason.plan","argureon.plan","seedops.request","goals.update","oracle.market","metrics.usage"],
    "seedbus_topics_pub":["ethics.decision","ethics.alert","ethics.quarantine","ethics.ticket"],
    "seedctl_commands":[
      {"cmd":"seedctl agent start pareon","effect":"Launch Páreon service"},
      {"cmd":"seedctl agent stop pareon","effect":"Stop service"},
      {"cmd":"seedctl policy check --req <REQ_ID>","effect":"Force-evaluate a pending request"},
      {"cmd":"seedctl policy ticket --req <REQ_ID>","effect":"Issue signed approval ticket if compliant"},
      {"cmd":"seedctl policy quarantine --ref <OBJ>","effect":"Quarantine an object/action with rationale"}
    ]
  },
  "policy_gate":{"relay":"seedrelay","mandatory":true,"tickets_required_for":["seedops.execute","argureon.plan.publish","reason.plan.execute"]},
  "capabilities_ref":"pareon-capabilities-1",
  "ethics_ref":"pareon-ethics-1",
  "goals_ref":"pareon-goals-1",
  "prompts_ref":"pareon-prompts-1",
  "profile_ref":"pareon-profile-1",
  "constraints":[
    {"name":"Language policy","rule":"C99 core; C++ only if strictly required for llama.cpp integration."},
    {"name":"Authority","rule":"Can veto or quarantine any action lacking policy ticket or violating Codex Solbian."}
  ],
  "health":{"liveness_probe":"pareon/health","readiness_probe":"pareon/ready"}
}