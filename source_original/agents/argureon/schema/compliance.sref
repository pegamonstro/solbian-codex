{
  "schema":"finance.compliance.v1",
  "jurisdictions":["PT","EU"],
  "rules": {
    "PT": {
      "capital_gains": {"method":"FIFO","netting_window_days":365,"loss_carry_forward_years":5},
      "vat": {"rates":{"standard":0.23,"reduced":0.13,"super_reduced":0.06},"reverse_charge":true},
      "income_categories":["A","B","E","G","H"]
    }
  },
  "reporting": {"freq":"MONTHLY,QUARTERLY,ANNUAL","forms":["IRS","VAT","inventory","withholding"]}
}

