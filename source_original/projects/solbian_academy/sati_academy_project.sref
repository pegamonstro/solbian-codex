{
  "schema_version": "sref_v5",
  "id": "project.solbian_academy:sati_academy",
  "type": "project.solbian_academy",
  "title": "S.A.T.I. Academy – Symbolic Adaptive Tutoring Interface",
  "description": "A standalone symbolic project for building a learning academy system that adapts to students' archetypes, aptitudes, and progression using merit-based symbolic logic and interactive educational projects.",
  "language": ["C99", "C++17", "LISP (Femtolisp)"],
  "features": [
    "Symbolic adaptive learning system (S.A.T.I.) for all age ranges",
    "Merit-based subject tree (tech-tree style) with curriculum-aware progression",
    "Fully expandable and editable subject/task/project tree",
    "Symbolic profiling of students (archetype, aptitude, trajectory)",
    "Memory-based learning evolution and feedback system",
    "User database: student, teacher, admin with login/password and stats tracking",
    "Each student develops holistic, integrative final projects (e.g. drone, satellite, robot)",
    "Persistent symbolic memory and project ledger for each user"
  ],
  "architecture": {
    "layer_0": "C - deterministic system operations, database, user management",
    "layer_1": "C++ - complex operations, subject tree logic, performance-critical reasoning",
    "layer_2": "LISP - symbolic reasoning, meta-programming, learning evolution, adaptation"
  },
  "learning_model": {
    "approach": "Merit-based subject unlocking with increasing complexity and agency",
    "structure": "Tree of subjects, skills, knowledge nodes with project milestones",
    "feedback": "Student performance feeds S.A.T.I. learning model and memory",
    "guidance": "Archetype + aptitude analysis drives symbolic guidance system"
  },
  "project_trajectory": [
    "Initial Subject Selection → Task Execution → Merit Point Accumulation",
    "→ Project Unlock → Project Completion → Skill Advancement",
    "→ Final Integrated Projects (e.g. drone, balloon, satellite, etc)"
  ],
  "status": "planned",
  "editability": "fully editable and expandable in all layers: subject tree, archetype mapping, symbolic logic, and project templates"
}
