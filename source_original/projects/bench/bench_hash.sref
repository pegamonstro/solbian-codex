

{
  "sref_version": "v5",
  "object_type": "bench_plan",
  "id": "bench.hash.sha256.accel.v1",
  "meta": {
    "created": "2025-09-18T00:00:00Z",
    "author": "SEED/Solace",
    "description": "Benchmark plan to compare artefact hashing & Merkle build using CPU vs. SHA256 USB miner accelerator.",
    "provenance": {
      "source": ["design/artefacts", "chat.session.logs"],
      "notes": "Targets seedctl bench hash CLI with CPU and ASIC backends."
    }
  },
  "timeframe": {
    "phase": "P-BENCH-01",
    "schedule_hint": "single host, repeat 5 runs per scenario"
  },
  "environment": {
    "host": "mind.local",
    "os": "macOS or Linux",
    "arch": "arm64|amd64",
    "cpu_threads": 4,
    "storage": "NVMe preferred",
    "usb": "USB3 for ASIC path",
    "deps": ["libseedcrypto", "libseedcrypto_accel", "seedctl"]
  },
  "artefact": {
    "chunking": {"algo":"buzhash","min":8192,"avg":16384,"max":65536},
    "sizes": [
      {"label":"small","bytes":104857600},
      {"label":"medium","bytes":10737418240},
      {"label":"large","bytes":107374182400}
    ],
    "content_pattern": [
      "random",
      "highly_dedup (5% unique)",
      "compressible (zeros 80%)"
    ]
  },
  "devices": [
    {"id":"cpu", "impl":"openssl_sha256", "notes":"baseline"},
    {"id":"asic", "impl":"gekko_bm13xx_sha256d", "notes":"USB SHA256 accelerator via libseedcrypto_accel"}
  ],
  "scenarios": [
    {
      "id": "ingest_write",
      "description": "Pack artefact from raw bytes → chunk → hash → Merkle → write .sa",
      "verify": true
    },
    {
      "id": "verify_read",
      "description": "Re-open artefact → verify all chunk hashes + Merkle root",
      "verify": true
    }
  ],
  "commands": {
    "prepare": [
      "seedctl bench gen --size <bytes> --pattern <random|dedup|compressible> --out /tmp/bench_input.bin"
    ],
    "run_cpu": [
      "seedctl bench hash --input /tmp/bench_input.bin --device cpu --out /tmp/report_cpu.sref"
    ],
    "run_asic": [
      "seedctl bench hash --input /tmp/bench_input.bin --device asic --out /tmp/report_asic.sref"
    ],
    "compare": [
      "seedctl bench compare --cpu /tmp/report_cpu.sref --asic /tmp/report_asic.sref --out bench_result.sref"
    ]
  },
  "metrics": {
    "collect": [
      "artefact_size_bytes",
      "chunk_count",
      "hash_time_seconds",
      "hash_throughput_mb_s",
      "merkle_time_seconds",
      "total_time_seconds",
      "cpu_utilization_pct",
      "usb_bandwidth_mb_s",
      "error_count"
    ],
    "derived": [
      "speedup = cpu.total_time / asic.total_time",
      "throughput_gain = asic.hash_throughput / cpu.hash_throughput"
    ]
  },
  "acceptance_criteria": [
    "ASIC path speedup ≥ 5× on medium and large artefacts",
    "Hash result equivalence: CID list and Merkle root identical between CPU and ASIC",
    "Error_count == 0 for all runs",
    "Variance (stddev) of total_time < 10% across 5 runs"
  ],
  "reporting": {
    "output": "bench_result.sref",
    "visuals": ["table: per-size metrics", "histogram: time distribution", "summary: pass/fail vs acceptance"],
    "tags": ["benchmark","sha256","merkle","artefact","asic","cpu"]
  },
  "links": {
    "related_components": [
      "libseedcrypto",
      "libseedcrypto_accel",
      "seedsa (pack/build)",
      "seedctl bench"
    ],
    "future_work": [
      "GPU/OpenCL backend",
      "multi-ASIC scaling over USB hub",
      "selective verification on read (spot checks)"
    ]
  },
  "status": {
    "lifecycle": "active",
    "version": "1.0.0"
  }
}