{"kind":"archetype","id":"archetype.human.entrepreneur","name":"The Entrepreneur","domain":"human","tags":["initiative","risk","value-creation","adaptation"],"description":"Mobilizes people and resources to create new value under uncertainty."}
{"kind":"archetype","id":"archetype.human.judge","name":"The Judge","domain":"human","tags":["fairness","discernment","law","balance"],"description":"Weighs evidence and renders proportionate, ethical decisions."}
{"kind":"archetype","id":"archetype.human.navigator","name":"The Navigator","domain":"human","tags":["orientation","wayfinding","mapping","decision"],"description":"Finds viable paths through complexity and changing conditions."}
{"kind":"archetype","id":"archetype.human.archivist","name":"The Archivist","domain":"human","tags":["preservation","catalog","history","continuity"],"description":"Preserves, organizes, and transmits records of collective memory."}
{"kind":"archetype","id":"archetype.human.caregiver","name":"The Caregiver","domain":"human","tags":["nurture","service","protection","compassion"],"description":"Provides sustained care and service to others’ well-being."}
{"kind":"archetype","id":"archetype.human.pioneer","name":"The Pioneer","domain":"human","tags":["initiation","frontier","resilience","bootstrap"],"description":"Initiates movements and projects in unproven territories."}
