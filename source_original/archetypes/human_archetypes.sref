{"kind":"archetype","id":"archetype.human.sage","name":"The Sage","domain":"human","tags":["wisdom","reflection","guidance","knowledge"],"description":"Seeks wisdom and shares distilled understanding; a custodian of memory."}
{"kind":"archetype","id":"archetype.human.warrior","name":"The Warrior","domain":"human","tags":["courage","protection","discipline","justice"],"description":"Defends what matters, acting with courage, discipline, and a sense of justice."}
{"kind":"archetype","id":"archetype.human.healer","name":"The Healer","domain":"human","tags":["care","repair","restoration","compassion"],"description":"Nurtures and restores health—physical, emotional, social, or ecological."}
{"kind":"archetype","id":"archetype.human.rebel","name":"The Rebel","domain":"human","tags":["challenge","change","innovation","subversion"],"description":"Challenges harmful norms and catalyzes change toward fairer systems."}
