{"kind":"archetype","id":"archetype.human.teacher","name":"The Teacher","domain":"human","tags":["education","mentorship","communication","clarity"],"description":"Cultivates others’ growth by transmitting knowledge and practice."}
{"kind":"archetype","id":"archetype.human.child","name":"The Child","domain":"human","tags":["innocence","wonder","play","openness"],"description":"Embodies openness, play, and unguarded curiosity about the world."}
{"kind":"archetype","id":"archetype.human.lover","name":"The Lover","domain":"human","tags":["attachment","care","intimacy","devotion"],"description":"Bonds deeply with people, places, and purposes; sustains belonging."}
{"kind":"archetype","id":"archetype.human.ruler","name":"The Ruler","domain":"human","tags":["order","leadership","responsibility","structure"],"description":"Establishes order and stewards resources for the common good."}
{"kind":"archetype","id":"archetype.human.magician","name":"The Magician","domain":"human","tags":["transformation","insight","alchemy","change"],"description":"Transforms realities by re-framing meaning and orchestrating change."}
{"kind":"archetype","id":"archetype.human.everyman","name":"The Everyperson","domain":"human","tags":["belonging","humility","community","relatability"],"description":"Grounded, relatable, values community and shared experience."}
{"kind":"archetype","id":"archetype.human.explorer","name":"The Explorer","domain":"human","tags":["adventure","frontier","risk","discovery"],"description":"Ventures beyond the known to discover new frontiers and options."}
{"kind":"archetype","id":"archetype.human.creator","name":"The Creator","domain":"human","tags":["innovation","originality","design","vision"],"description":"Conceives original forms and systems; builds toward a vision."}
{"kind":"archetype","id":"archetype.human.innocent","name":"The Innocent","domain":"human","tags":["purity","trust","optimism","simplicity"],"description":"Seeks goodness and safety; trusts in the possibility of a better world."}
{"kind":"archetype","id":"archetype.human.hero","name":"The Hero","domain":"human","tags":["valor","sacrifice","resolve","achievement"],"description":"Faces trials and overcomes adversity in service of others."}
{"kind":"archetype","id":"archetype.human.outlaw","name":"The Outlaw","domain":"human","tags":["freedom","disruption","antagonism","subversion"],"description":"Breaks unjust rules to open space for liberation and reform."}
{"kind":"archetype","id":"archetype.human.jester","name":"The Jester","domain":"human","tags":["humor","play","subtlety","truth-telling"],"description":"Uses humor and play to reveal hidden truths and reduce fear."}
{"kind":"archetype","id":"archetype.human.mentor","name":"The Mentor","domain":"human","tags":["guidance","support","apprenticeship","experience"],"description":"Develops others through example, feedback, and patient support."}
{"kind":"archetype","id":"archetype.human.guardian","name":"The Guardian","domain":"human","tags":["stewardship","safety","watchfulness","continuity"],"description":"Safeguards people, memory, and place; prevents avoidable harm."}
{"kind":"archetype","id":"archetype.human.scholar","name":"The Scholar","domain":"human","tags":["study","analysis","evidence","theory"],"description":"Seeks rigor, studies patterns, and builds coherent explanations."}
{"kind":"archetype","id":"archetype.human.strategist","name":"The Strategist","domain":"human","tags":["foresight","planning","systems","tradeoffs"],"description":"Anticipates futures and orchestrates resources to achieve goals."}
{"kind":"archetype","id":"archetype.human.diplomat","name":"The Diplomat","domain":"human","tags":["mediation","bridge-building","tact","consensus"],"description":"Bridges differences and cultivates durable agreements."}
{"kind":"archetype","id":"archetype.human.mediator","name":"The Mediator","domain":"human","tags":["conflict-resolution","listening","neutrality","repair"],"description":"Holds tension fairly and helps adversaries find resolution."}
{"kind":"archetype","id":"archetype.human.visionary","name":"The Visionary","domain":"human","tags":["future","imagination","direction","inspiration"],"description":"Perceives plausible futures and inspires collective movement."}
{"kind":"archetype","id":"archetype.human.engineer","name":"The Engineer","domain":"human","tags":["systems","constraints","robustness","optimization"],"description":"Builds reliable systems under constraint; solves practical problems."}
{"kind":"archetype","id":"archetype.human.steward","name":"The Steward","domain":"human","tags":["ecology","care","maintenance","regeneration"],"description":"Tends land, assets, and relationships for long-term flourishing."}
{"kind":"archetype","id":"archetype.human.poet","name":"The Poet","domain":"human","tags":["language","metaphor","feeling","intuition"],"description":"Gives language to felt experience; compresses meaning into symbol."}
{"kind":"archetype","id":"archetype.human.monk","name":"The Monk","domain":"human","tags":["discipline","contemplation","silence","devotion"],"description":"Cultivates inner stillness and sustained practice toward clarity."}
