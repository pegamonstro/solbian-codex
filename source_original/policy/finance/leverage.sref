

{
  "schema": "policy.finance.leverage.v1",
  "id": "finance:leverage_policy",
  "version": "1.0.0",
  "defaults": {
    "spot_max_leverage": 1.0,
    "futures_max_leverage": 2.0,
    "initial_margin_buffer_pct": 0.10,
    "maintenance_margin_buffer_pct": 0.15,
    "liquidation_distance_atr_mult": 2.0,
    "cooldown_seconds_after_change": 300
  },
  "per_venue": {
    "poloniex.spot": {
      "max_leverage": 1.0,
      "max_position_pct": 0.15
    },
    "poloniex.futures": {
      "max_leverage": 2.0,
      "max_position_pct": 0.15,
      "reduce_only_on_drawdown_pct": 0.08
    }
  },
  "risk_tiers": [
    {
      "tier": "low_vol",
      "atr_pct_threshold_max": 0.02,
      "max_leverage": 2.0,
      "init_margin_pct": 0.50,
      "maint_margin_pct": 0.35
    },
    {
      "tier": "med_vol",
      "atr_pct_threshold_max": 0.05,
      "max_leverage": 1.5,
      "init_margin_pct": 0.67,
      "maint_margin_pct": 0.45
    },
    {
      "tier": "high_vol",
      "atr_pct_threshold_max": 1.00,
      "max_leverage": 1.0,
      "init_margin_pct": 1.00,
      "maint_margin_pct": 0.60
    }
  ],
  "per_asset": {
    "BTC-USDT": {
      "futures_max_leverage": 2.0,
      "spot_max_leverage": 1.0,
      "min_notional_usdt": 10
    },
    "ETH-USDT": {
      "futures_max_leverage": 2.0,
      "spot_max_leverage": 1.0,
      "min_notional_usdt": 10
    }
  },
  "position_size_tiers": [
    { "notional_upper_usdt": 500, "max_leverage": 2.0 },
    { "notional_upper_usdt": 2000, "max_leverage": 1.5 },
    { "notional_upper_usdt": 10000, "max_leverage": 1.0 }
  ],
  "regime_controls": {
    "allowed_regimes": ["bull", "bear", "sideways", "panic"],
    "max_leverage_by_regime": {
      "bull": 2.0,
      "sideways": 1.5,
      "bear": 1.25,
      "panic": 1.0
    }
  },
  "auto_risk_reduction": {
    "trigger_drawdown_pct": 0.08,
    "step_leverage_reduction": 0.25,
    "min_leverage_after_reduction": 1.0,
    "auto_close_pct_if_liq_distance_atr_lt": 0.5
  },
  "approval_thresholds": {
    "requires_pareon_if": {
      "requested_leverage_gt": 2.0,
      "venue_exposure_pct_gt": 0.40,
      "portfolio_var_1d_pct_gt": 0.05
    }
  },
  "prohibited": {
    "assets": ["symbols:scam/*"],
    "venues": [],
    "conditions": ["withdrawals_with_open_positions"]
  },
  "observability": {
    "export_metrics": true,
    "metrics": [
      "current_leverage",
      "init_margin",
      "maint_margin",
      "distance_to_liquidation_atr",
      "drawdown_pct",
      "var_1d_95"
    ]
  }
}