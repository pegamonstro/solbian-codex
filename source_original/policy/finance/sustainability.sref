{
  "schema": "policy.finance.sustainability.v1",
  "id": "finance:sustainability_policy",
  "version": "1.0.0",
  "objectives": {
    "goal": "Ensure financial operations and strategies of S.E.E.D. align with long-term ecological, social, and ethical sustainability.",
    "principles": [
      "avoid_harmful_investments",
      "prioritize_green_and_social_projects",
      "integrate_codex_covenants",
      "promote_circular_economy",
      "support_open_knowledge_and_education"
    ]
  },
  "exclusions": {
    "sectors": [
      "fossil_fuels",
      "arms_and_weapons",
      "tobacco",
      "gambling",
      "exploitative_labor"
    ],
    "blacklist_assets": [
      "symbols:coal/*",
      "symbols:oil/*",
      "symbols:arms/*"
    ]
  },
  "priorities": {
    "sectors": [
      "renewable_energy",
      "sustainable_agriculture",
      "circular_industries",
      "education",
      "healthcare",
      "responsible_ai"
    ],
    "whitelist_assets": [
      "symbols:solar/*",
      "symbols:wind/*",
      "symbols:recycling/*",
      "symbols:edu/*",
      "symbols:health/*"
    ]
  },
  "metrics": {
    "portfolio_sustainable_allocation_pct": 0.60,
    "carbon_intensity_threshold": 100,
    "esg_score_min": 70,
    "audit_frequency_days": 30
  },
  "reporting": {
    "frequency_days": 90,
    "responsible_agent": "argureon",
    "format": ["json", "pdf"]
  }
}
