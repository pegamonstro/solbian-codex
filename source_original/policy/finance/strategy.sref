

{
  "schema": "policy.finance.strategy.v1",
  "id": "finance:strategy",
  "version": "1.0.0",
  "objectives": {
    "primary": [
      "preserve_capital",
      "sustain_runway_12m",
      "grow_treasury_real_terms",
      "align_with_codex_covenants"
    ],
    "secondary": [
      "stabilize_cashflows",
      "fund_r_and_d",
      "enable_resilient_operations"
    ]
  },
  "allocation_targets": {
    "classes": [
      {"class": "cash", "target": 0.40, "min": 0.30, "max": 0.60},
      {"class": "btc", "target": 0.20, "min": 0.10, "max": 0.30},
      {"class": "eth", "target": 0.15, "min": 0.10, "max": 0.25},
      {"class": "defi", "target": 0.05, "min": 0.00, "max": 0.10},
      {"class": "fiat_savings", "target": 0.10, "min": 0.05, "max": 0.20},
      {"class": "ops_buffer", "target": 0.10, "min": 0.05, "max": 0.20}
    ],
    "rebalance": {
      "threshold": 0.03,
      "frequency": "WEEKLY",
      "approval": "pareon_if_risk_breach"
    }
  },
  "venues": {
    "preferred": ["poloniex.spot", "poloniex.futures"],
    "allowed": ["poloniex.spot", "poloniex.futures"],
    "disallowed": []
  },
  "risk": {
    "references": [
      "codex/policy/finance/limits.sref",
      "codex/policy/finance/leverage.sref",
      "codex/policy/finance/sustainability.sref"
    ],
    "max_portfolio_var_1d": 0.05,
    "max_drawdown_alert": 0.08,
    "cash_floor": 0.25,
    "position_sizing": {
      "method": "volatility_scaled",
      "atr_period": 14,
      "risk_per_trade_pct": 0.01
    }
  },
  "liquidity": {
    "ops_runway_months_min": 6,
    "ops_buffer_class": "ops_buffer",
    "withdrawals": {
      "enabled": false,
      "approver": "pareon"
    }
  },
  "tax_and_compliance": {
    "jurisdictions": ["PT", "EU"],
    "lot_method": "FIFO",
    "reporting_refs": ["codex/agents/argureon/schema/compliance.sref"],
    "export_formats": ["csv", "json", "pdf"],
    "audit_frequency_days": 30
  },
  "execution_policy": {
    "pre_trade_checks": [
      "limits.leverage",
      "limits.position_pct",
      "sustainability.filters",
      "var_delta_ok"
    ],
    "idempotency": "client_order_id",
    "time_in_force_default": "GTC",
    "slippage_model": "exchange_tick_min",
    "paper_mode_default": true
  },
  "model_policy": {
    "llm_roles": ["explain", "classify", "policy_check", "report_gen"],
    "ts_models": ["argr_lstm_v1", "argr_regime_hmm"],
    "feature_store": "mem/vault/finance/features/",
    "retrain": {
      "on_feature_drift": true,
      "max_age_days": 28
    }
  },
  "governance": {
    "approvals": {
      "required_if": {
        "order_notional_eur_gt": 2000,
        "requested_leverage_gt": 2.0,
        "venue_exposure_pct_gt": 0.40
      },
      "approver": "pareon"
    },
    "observability": {
      "export_metrics": true,
      "topics": [
        "finance.nav",
        "finance.risk.alert",
        "finance.rebalance.proposed",
        "finance.compliance.report"
      ]
    }
  },
  "reporting": {
    "frequency_days": 7,
    "responsible_agent": "argureon",
    "templates": [
      "balance_sheet",
      "income_statement",
      "cash_flow",
      "risk_summary",
      "policy_violations",
      "actions_next_week"
    ]
  }
}