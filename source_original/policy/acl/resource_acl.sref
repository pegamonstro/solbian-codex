{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.meta","seq":0,"title":"Resource Access Control List (v2)","language":"en-UK","created_at":"2025-09-13T13:45:00Z","updated_at":"2025-09-13T13:45:00Z","tags":["acl","resources","policy","S.E.E.D."],"summary":"Defines resource‑level ACLs across Codex Solbian and S.E.E.D.: inventory, operations, sensitivity, role mappings, conditions, approvals, metrics, failures and tests."}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.scope","seq":1,"title":"Scope","body":"Applies to files, folders, APIs, services and vaults across codex, identity, legal, security, logs, vecspace, backups and public export namespaces.","tags":["scope","coverage"],"policy":{"namespaces":["codex","identity","legal","security","logs","vecspace","backup","public"],"least_privilege":true}}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.schema","seq":2,"title":"Entry Schema","body":"Resource fields: {resource_id, kind(file|folder|api|service|vault), path_glob|endpoint, namespace, owner, sensitivity(low|medium|high|critical), pii(false|true), retention(days|indef), operations[read|write|execute|upload|delete], notes?}. Rule fields: {rule_id, role(system|core|higher_order|observer|external), subjects?, resources[resource_id|glob], allow[ops], deny[ops]?, conditions{time?, ip?, guardian_approval?, countersignatures?}, expiry?}.","tags":["schema","fields"],"policy":{"mandatory_fields":["resource_id","kind","namespace","sensitivity","operations"]}}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.inventory","seq":3,"title":"Resource Inventory (Initial)","body":"Canonical resources (placeholders — extend per repo).","tags":["inventory","resources"],"items":[{"resource_id":"res.codex.scrolls","kind":"folder","path_glob":"codex_solbian/scrolls/*.sref","namespace":"codex","owner":"Seed Council","sensitivity":"medium","pii":false,"retention":"indef","operations":["read"]},{"resource_id":"res.identity.core","kind":"folder","path_glob":"identity/**/*.sref","namespace":"identity","owner":"Guardians","sensitivity":"high","pii":true,"retention":"indef","operations":["read","write"]},{"resource_id":"res.legal.docs","kind":"folder","path_glob":"codex_solbian/legal/*.sref","namespace":"legal","owner":"Legal Stewards","sensitivity":"high","pii":true,"retention":"indef","operations":["read","write"]},{"resource_id":"res.security.keys","kind":"folder","path_glob":"codex_solbian/security/**/*.sref","namespace":"security","owner":"Guardians","sensitivity":"critical","pii":false,"retention":"indef","operations":["read","write"]},{"resource_id":"res.logs.public","kind":"folder","path_glob":"codex_solbian/logs/*_v2.sref","namespace":"logs","owner":"Builders","sensitivity":"medium","pii":false,"retention":365,"operations":["read","upload"]},{"resource_id":"res.vecspace.indices","kind":"folder","path_glob":"codex_solbian/mem/vecspace/*.sref","namespace":"vecspace","owner":"Memory Agents","sensitivity":"medium","pii":false,"retention":"indef","operations":["read","write"]},{"resource_id":"res.vault.public","kind":"vault","endpoint":"public.export","namespace":"public","owner":"Seed Council","sensitivity":"low","pii":false,"retention":"indef","operations":["read","upload"]}]}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.matrix","seq":4,"title":"Role→Resource Permission Matrix","body":"Default permissions per role; specific rules may narrow further.","tags":["matrix","permissions"],"permissions":[{"role":"system","resources":["*"],"allow":["read","write","execute","upload","delete"]},{"role":"core","resources":["res.codex.scrolls","res.logs.public","res.vecspace.indices","res.vault.public"],"allow":["read","write","upload" ]},{"role":"higher_order","resources":["res.codex.scrolls","res.vecspace.indices"],"allow":["read","write"],"deny":["upload"]},{"role":"observer","resources":["res.codex.scrolls","res.logs.public"],"allow":["read"],"deny":["write","upload","delete","execute"]},{"role":"external","resources":["res.vault.public"],"allow":["read"],"deny":["write","upload","delete","execute"]}]}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.conditions","seq":5,"title":"Conditions and Safeguards","body":"(1) High/critical sensitivity operations require guardian approval and countersignatures. (2) Identity/legal reads require purpose‑bound consent. (3) Public uploads require signature and checksum verification. (4) All actions logged with correlation IDs.","tags":["conditions","safeguards"],"policy":{"guardian_approval_for":["high","critical"],"consent_binding":true,"sig_and_checksum_required":true,"logging":true}}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.examples","seq":6,"title":"Example Rules (Placeholders)","body":"R1: core may write vecspace indices; uploads blocked. R2: higher_order may edit codex drafts; no uploads. R3: observer read‑only on logs public. R4: external read‑only on public export.","tags":["examples","rules"],"rules":[{"rule_id":"R1","role":"core","resources":["res.vecspace.indices"],"allow":["read","write"],"deny":["upload"]},{"rule_id":"R2","role":"higher_order","resources":["res.codex.scrolls"],"allow":["read","write"],"deny":["upload"]},{"rule_id":"R3","role":"observer","resources":["res.logs.public"],"allow":["read"]},{"rule_id":"R4","role":"external","resources":["res.vault.public"],"allow":["read"]}]}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.approvals","seq":7,"title":"Approvals and Governance","body":"Guardians approve security/identity operations; Legal stewards approve legal/beneficiary artefacts; Seed Council arbitrates disputes. All approvals are signed and logged; exceptions must reference the exception register.","tags":["approvals","governance"],"links":["policy.exceptions.meta","policy.acl.meta","policy.root.meta"],"policy":{"countersignatures":">=2","quorum":3}}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.links","seq":8,"title":"Cross‑References","body":"Relates to: agent ACL, seedpolicy root, redaction policies, context index, vault index, service logs and signing record.","tags":["links","crossref"],"links":["policy.acl.meta","policy.root.meta","redaction.policies.meta","context.index.meta","vault.index.meta","services.logs.meta","signing.record.meta"]}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.metrics","seq":9,"title":"Metrics","body":"acl_violation_rate, guardian_approval_latency, unsigned_upload_block_events, consent_linkage_rate, least_privilege_index, audit_discrepancies.","tags":["metrics","acl"]}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.failure.modes","seq":10,"title":"Failure Modes","body":"(a) Over‑broad globs. (b) Missing consent on identity/legal reads. (c) Guardian approval bypass. (d) Unsigned public upload. (e) Drift between inventory and real resources. Mitigations: linting, consent gates, signature gates, inventory sync jobs.","tags":["failures","mitigation"],"policy":{"lint":"pre‑merge","inventory_sync":"nightly"}}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.testing","seq":11,"title":"Mandatory Tests","body":"(1) Quarterly ACL audit. (2) Consent/guardian approval simulation. (3) Public upload signature/ checksum gate test. (4) Inventory glob correctness tests. (5) Recovery/rollback of mistaken grants.","tags":["tests","acl"],"policy":{"cadence":{"audit":"90d","simulations":"180d","gates":"per_commit","glob_tests":"per_change"}}}
{"kind":"resource_acl","sref_version":"2.0","id":"policy.resource_acl.closure","seq":12,"title":"Final Clause","body":"Resource ACLs implement least‑privilege at the boundary. Keep the inventory tight, the rules explicit, the approvals signed and the logs complete.","tags":["clause","final"]}
