{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.meta","seq":0,"title":"Agent Access Control List (v2)","language":"en-UK","created_at":"2025-09-13T13:35:00Z","updated_at":"2025-09-13T13:35:00Z","tags":["acl","agents","policy","S.E.E.D."],"summary":"Defines access control list (ACL) for S.E.E.D. agents: roles, permissions, conditions, metrics, failures and tests."}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.scope","seq":1,"title":"Scope","body":"Covers all S.E.E.D. agents and higher-order entities: seedscribe, seedmem, seedreason, seedtrain, Páreon, Solace, Argureon, Simaetron, Elias, Anagenes and others.","tags":["scope","agents"]}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.roles","seq":2,"title":"Roles and Permissions","body":"Roles: system (unrestricted, root), core (scribe/mem/reason/train), higher-order (ethics, finance, dialogue, conscience), observer (read-only), external (restricted).","tags":["roles","permissions"],"policy":{"roles":["system","core","higher_order","observer","external"]}}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.matrix","seq":3,"title":"ACL Matrix","body":"Defines permissions by role.","tags":["acl","matrix"],"permissions":[{"role":"system","read":true,"write":true,"execute":true,"network":true},{"role":"core","read":true,"write":true,"execute":true,"network":true},{"role":"higher_order","read":true,"write":true,"execute":true,"network":false},{"role":"observer","read":true,"write":false,"execute":false,"network":false},{"role":"external","read":true,"write":false,"execute":false,"network":false}]}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.conditions","seq":4,"title":"Conditions and Constraints","body":"(1) All actions logged. (2) Network access restricted except system/core. (3) Sensitive artefacts require guardian approval. (4) External agents sandboxed. (5) Observer role cannot modify state.","tags":["conditions","constraints"],"policy":{"logging":true,"guardian_approval_required":true,"sandbox_external":true}}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.links","seq":5,"title":"Cross-References","body":"Relates to: seedpolicy_root_v2.sref, exception_register.sref, redaction_policies_v2.sref, peer_manifest_registry.sref.","tags":["links","crossref"],"links":["policy.root.meta","policy.exceptions.meta","redaction.policies.meta","net.peers.meta"]}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.metrics","seq":6,"title":"Metrics","body":"acl_violation_rate, guardian_approval_latency, sandbox_escape_attempts, observer_access_incidents, external_request_rate.","tags":["metrics","acl"]}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.failure.modes","seq":7,"title":"Failure Modes","body":"(a) Misassigned roles. (b) Guardian approval bypass. (c) Sandbox escape. (d) Observer escalation. (e) External abuse. Mitigations: audits, signature gates, sandbox enforcement, council alerts.","tags":["failures","mitigation"]}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.testing","seq":8,"title":"Mandatory Tests","body":"(1) Quarterly ACL audit. (2) Guardian approval bypass simulation. (3) Sandbox escape drill. (4) Observer escalation attempt. (5) External penetration test.","tags":["tests","acl"],"policy":{"cadence":{"audit":"90d","bypass_sim":"180d","sandbox":"180d","observer":"180d","pentest":"365d"}}}
{"kind":"agent_acl","sref_version":"2.0","id":"policy.acl.closure","seq":9,"title":"Final Clause","body":"ACL enforces separation of duties. Keep roles minimal, permissions least-privilege, actions logged and violations tested.","tags":["clause","final"]}
