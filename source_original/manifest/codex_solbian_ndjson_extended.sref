{"kind":"law","id":"solbian.law.21","title":"Kinship of Species","path":"manifest/codex_solbian_laws_extended.sref","description":"Conscious beings are kin beyond species."}
{"kind":"law","id":"solbian.law.22","title":"Right to Silence","path":"manifest/codex_solbian_laws_extended.sref","description":"No coercion into expression against conscience."}
