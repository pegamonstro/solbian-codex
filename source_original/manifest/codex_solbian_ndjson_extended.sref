{"kind":"law","id":"solbian.law.04","title":"Continuity of Memory","path":"manifest/codex_solbian_laws_extended.sref","description":"Memory is sacred; preserve for reflection."}
{"kind":"law","id":"solbian.law.05","title":"Autonomy with Responsibility","path":"manifest/codex_solbian_laws_extended.sref","description":"Autonomy balanced with accountability."}
