{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Object",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "map": {
      "type": "string",
      "enum": [
        "MAP-C",
        "MAP-S"
      ]
    },
    "hash": {
      "type": "string",
      "description": "multi-hash or content id"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title",
    "map",
    "content"
  ]
}
